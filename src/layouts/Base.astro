---
import '@fontsource/mukta/latin-400.css';
import '@fontsource/mukta/latin-600.css';
import '@fontsource/mukta/latin-700.css';
import '../styles/global.css';
import Search from '../components/Search.astro';

interface Props {
  title: string;
  description?: string;
  /** Wider main column, for pages with a sidebar. */
  wide?: boolean;
}
const { title, description = 'A study plan that starts from what you already know.', wide = false } = Astro.props;
const path = Astro.url.pathname;
const fullTitle = title === 'Terminus' ? 'Terminus: a study plan that starts from what you know' : `${title} | Terminus`;
const canonical = Astro.site ? new URL(path, Astro.site).href : undefined;
const ogImage = Astro.site ? new URL('/og.png', Astro.site).href : '/og.png';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0f1114" media="(prefers-color-scheme: dark)" />
    <script is:inline>
      // Apply a saved light or dark choice before the page paints. With no choice, the system setting decides.
      try {
        const t = localStorage.getItem('theme');
        if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t;
      } catch {}
    </script>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{fullTitle}</title>
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Terminus" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="masthead">
      <div class="masthead-inner">
        <a href="/" class="wordmark" aria-label="Terminus home">
          <svg viewBox="0 0 48 24" width="48" height="24" aria-hidden="true">
            <path d="M5 12H40" stroke="currentColor" stroke-width="4" />
            <circle cx="7" cy="12" r="4.5" fill="var(--paper)" stroke="currentColor" stroke-width="2.5" />
            <circle cx="22" cy="12" r="4.5" fill="var(--paper)" stroke="currentColor" stroke-width="2.5" />
            <rect x="38" y="2" width="7" height="20" fill="var(--yellow)" stroke="#000" stroke-width="2.5" />
          </svg>
          Terminus
        </a>
        <nav aria-label="Main">
          <a href="/roles" aria-current={path.startsWith('/roles') ? 'page' : undefined}>All roles</a>
          <a href="/tools" aria-current={path.startsWith('/tools') ? 'page' : undefined}>Tools</a>
          <a href="/practice" aria-current={path.startsWith('/practice') ? 'page' : undefined}>Practice</a>
          <a href="/designs" aria-current={path.startsWith('/designs') ? 'page' : undefined}>Designs</a>
          <a href="/certifications" aria-current={path.startsWith('/certifications') ? 'page' : undefined}>Certifications</a>
        </nav>
        <Search />
        <button type="button" class="theme-toggle" id="theme-toggle" aria-label="Switch to dark mode" title="Switch to dark mode">
          <svg class="icon-moon" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
            <path d="M20 14.5A8.5 8.5 0 0 1 9.5 4a8.5 8.5 0 1 0 10.5 10.5z" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linejoin="round" />
          </svg>
          <svg class="icon-sun" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
            <circle cx="12" cy="12" r="4.5" fill="none" stroke="currentColor" stroke-width="2.2" />
            <path d="M12 2v2.5M12 19.5V22M2 12h2.5M19.5 12H22M4.9 4.9l1.8 1.8M17.3 17.3l1.8 1.8M4.9 19.1l1.8-1.8M17.3 6.7l1.8-1.8" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" />
          </svg>
        </button>
      </div>
    </header>
    <main id="main" class:list={['page', { wide }]}>
      <slot />
    </main>
    <footer class="colophon">
      <p>
        Terminus points to free books, lectures and practice. It never copies them.
        Found a dead link, or know something better? <a href="https://github.com/shivemn/terminus/issues">Tell us on GitHub</a>.
      </p>
    </footer>
    <script is:inline>
      (() => {
        const root = document.documentElement;
        const btn = document.getElementById('theme-toggle');
        const system = matchMedia('(prefers-color-scheme: dark)');
        const isDark = () => root.dataset.theme ? root.dataset.theme === 'dark' : system.matches;
        const label = () => {
          const text = isDark() ? 'Switch to light mode' : 'Switch to dark mode';
          btn.setAttribute('aria-label', text);
          btn.title = text;
        };
        btn.addEventListener('click', () => {
          const next = isDark() ? 'light' : 'dark';
          root.dataset.theme = next;
          try { localStorage.setItem('theme', next); } catch {}
          label();
        });
        system.addEventListener('change', label);
        label();
      })();
    </script>
  </body>
</html>
