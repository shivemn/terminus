---
import '@fontsource/mukta/latin-400.css';
import '@fontsource/mukta/latin-600.css';
import '@fontsource/mukta/latin-700.css';
import '../styles/global.css';
import Search from '../components/Search.astro';

interface Props {
  title: string;
  description?: string;
  /** Wider main column, for pages with a sidebar. */
  wide?: boolean;
}
const { title, description = 'A study plan that starts from what you already know.', wide = false } = Astro.props;
const path = Astro.url.pathname;
const fullTitle = title === 'Terminus' ? 'Terminus: a study plan that starts from what you know' : `${title} | Terminus`;
const canonical = Astro.site ? new URL(path, Astro.site).href : undefined;
const ogImage = Astro.site ? new URL('/og.png', Astro.site).href : '/og.png';
const NAV = [
  { href: '/roles', title: 'All roles' },
  { href: '/tools', title: 'Tools' },
  { href: '/practice', title: 'Practice' },
  { href: '/designs', title: 'Designs' },
  { href: '/certifications', title: 'Certifications' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f6f1e3" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0f1114" media="(prefers-color-scheme: dark)" />
    <script is:inline>
      // Apply a saved light or dark choice before the page paints. With no choice, the system setting decides.
      try {
        const t = localStorage.getItem('theme');
        if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t;
      } catch {}
      // Animations only for people who haven't asked their system for less motion.
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches) document.documentElement.classList.add('motion');
    </script>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{fullTitle}</title>
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Terminus" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="masthead">
      <div class="masthead-inner">
        <a href="/" class="wordmark" aria-label="Terminus home">
          <svg viewBox="0 0 48 24" width="48" height="24" aria-hidden="true">
            <path d="M5 12H40" stroke="currentColor" stroke-width="4" />
            <circle cx="7" cy="12" r="4.5" fill="var(--paper)" stroke="currentColor" stroke-width="2.5" />
            <circle cx="22" cy="12" r="4.5" fill="var(--paper)" stroke="currentColor" stroke-width="2.5" />
            <rect x="38" y="2" width="7" height="20" fill="var(--yellow)" stroke="#000" stroke-width="2.5" />
          </svg>
          Terminus
        </a>
        <div class="masthead-menu" id="site-menu">
          <nav aria-label="Main">
            {NAV.map((n) => <a href={n.href} aria-current={path.startsWith(n.href) ? 'page' : undefined}>{n.title}</a>)}
          </nav>
          <Search />
        </div>
        <button type="button" class="theme-toggle" id="theme-toggle" aria-label="Switch to dark mode" title="Switch to dark mode">
          <span class="theme-knob" aria-hidden="true"></span>
        </button>
        <button type="button" class="menu-toggle" id="menu-toggle" aria-expanded="false" aria-controls="site-menu">
          <span class="menu-icon" aria-hidden="true"></span>Menu
        </button>
      </div>
    </header>
    <main id="main" class:list={['page', { wide }]}>
      <slot />
    </main>
    <footer class="colophon">
      <div class="colophon-inner">
        <p>
          Terminus points to free books, lectures and practice. It never copies them.
          Found a dead link, or know something better? <a href="https://github.com/shivemn/terminus/issues">Tell us on GitHub</a>.
          Code under MIT, content under CC BY-SA.
        </p>
        <nav aria-label="Footer">
          {NAV.map((n) => <a href={n.href}>{n.title}</a>)}
          <a href="https://github.com/shivemn/terminus">GitHub</a>
        </nav>
      </div>
    </footer>
    <script is:inline>
      (() => {
        const root = document.documentElement;
        const motion = () => root.classList.contains('motion');

        // Light and dark. The new theme spreads out from the switch where the browser can do it.
        const btn = document.getElementById('theme-toggle');
        const system = matchMedia('(prefers-color-scheme: dark)');
        const isDark = () => (root.dataset.theme ? root.dataset.theme === 'dark' : system.matches);
        const label = () => {
          const text = isDark() ? 'Switch to light mode' : 'Switch to dark mode';
          btn.setAttribute('aria-label', text);
          btn.title = text;
        };
        btn.addEventListener('click', () => {
          const next = isDark() ? 'light' : 'dark';
          const apply = () => {
            root.dataset.theme = next;
            try { localStorage.setItem('theme', next); } catch {}
            label();
          };
          if (!motion() || !document.startViewTransition) return apply();
          const r = btn.getBoundingClientRect();
          const x = r.left + r.width / 2;
          const y = r.top + r.height / 2;
          root.style.setProperty('--tx', `${x}px`);
          root.style.setProperty('--ty', `${y}px`);
          root.style.setProperty('--tr', `${Math.hypot(Math.max(x, innerWidth - x), Math.max(y, innerHeight - y))}px`);
          root.classList.add('theme-vt');
          const t = document.startViewTransition(apply);
          const done = () => root.classList.remove('theme-vt');
          t.finished.then(done, done);
        });
        system.addEventListener('change', label);
        label();

        // The masthead tightens once the page has moved, and tells sticky bars how tall it is.
        const head = document.querySelector('.masthead');
        const onScroll = () => root.classList.toggle('scrolled', scrollY > 24);
        addEventListener('scroll', onScroll, { passive: true });
        onScroll();
        const setHead = () => root.style.setProperty('--head-h', `${head.offsetHeight}px`);
        new ResizeObserver(setHead).observe(head);

        // The phone menu.
        const menuBtn = document.getElementById('menu-toggle');
        const menu = document.getElementById('site-menu');
        const setMenu = (open) => {
          root.classList.toggle('menu-open', open);
          menuBtn.setAttribute('aria-expanded', String(open));
        };
        menuBtn.addEventListener('click', () => setMenu(!root.classList.contains('menu-open')));
        menu.addEventListener('click', (e) => { if (e.target.closest('a')) setMenu(false); });
        document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && root.classList.contains('menu-open')) { setMenu(false); menuBtn.focus(); } });
        document.addEventListener('click', (e) => { if (!head.contains(e.target)) setMenu(false); });

        // A small press on every button.
        document.addEventListener('click', (e) => {
          if (!motion()) return;
          const b = e.target.closest && e.target.closest('button, .btn, [role="button"]');
          if (!b) return;
          const cls = b.offsetWidth > 260 ? 'pressed-soft' : 'pressed';
          b.classList.remove('pressed', 'pressed-soft');
          void b.offsetWidth;
          b.classList.add(cls);
          setTimeout(() => b.classList.remove(cls), 460);
        }, true);

        // Sections rise into place as they come into view.
        const reveal = () => {
          const els = [...document.querySelectorAll('[data-reveal]:not(.in)')];
          if (!motion() || !('IntersectionObserver' in window)) return els.forEach((el) => el.classList.add('in'));
          const io = new IntersectionObserver((entries) => {
            for (const en of entries) if (en.isIntersecting) { en.target.classList.add('in'); io.unobserve(en.target); }
          }, { rootMargin: '0px 0px -8% 0px', threshold: 0.06 });
          els.forEach((el) => io.observe(el));
        };
        reveal();
        addEventListener('load', () => setTimeout(() => document.querySelectorAll('[data-reveal]').forEach((el) => {
          // Anything already scrolled past (or a page opened at an anchor) shows at once.
          if (el.getBoundingClientRect().top < innerHeight) el.classList.add('in');
        }), 1200));

        // Going to a role: its name carries over into the yellow board on the role page.
        const roleLink = /^\/roles\/[^/?#]+/;
        document.addEventListener('click', (e) => {
          const a = e.target.closest && e.target.closest('a[href^="/roles/"]');
          if (!a || !(a instanceof HTMLElement) || e.metaKey || e.ctrlKey || e.shiftKey || e.button !== 0) return;
          document.querySelectorAll('[data-vt-board]').forEach((el) => { el.style.viewTransitionName = ''; el.removeAttribute('data-vt-board'); });
          const label = (a.dataset.boardFrom && document.querySelector(a.dataset.boardFrom)) || a.querySelector('[data-board-name]') || a;
          label.style.viewTransitionName = 'role-board';
          label.setAttribute('data-vt-board', '');
        });
        // Coming back from a role, the board flies back to the link it came from.
        addEventListener('pagereveal', (e) => {
          if (!e.viewTransition) return;
          try {
            const from = new URL(navigation.activation.from.url);
            const m = from.pathname.match(roleLink);
            if (!m || location.pathname.startsWith('/roles/')) return;
            const a = document.querySelector(`a[href^="${m[0]}"]:not([href*="#"])`);
            if (!(a instanceof HTMLElement)) return;
            const label = a.querySelector('[data-board-name]') || a;
            label.style.viewTransitionName = 'role-board';
            const done = () => { label.style.viewTransitionName = ''; };
            e.viewTransition.finished.then(done, done);
          } catch {}
        });
        addEventListener('pageshow', () => document.querySelectorAll('[data-vt-board]').forEach((el) => { el.style.viewTransitionName = ''; }));
      })();
    </script>
  </body>
</html>
