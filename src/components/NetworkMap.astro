---
// The home page network map. Lines are families, stations are the stops
// most of a family's roles need, interchanges are stops lines share, and
// every job is a terminus at the end of its line. Drawn at build time; a
// small script lights up a role on hover, greys out what the ticket's
// background covers, filters to one line, zooms and pans, and opens a card
// for a job when you pick it.
import { buildNetwork } from '../lib/network';
import { content } from '../lib/site';

interface Props {
  /** Its own row of line chips. Off when the page puts the chips above the map. */
  chips?: boolean;
}
const { chips = true } = Astro.props;
const c = content();
const jobs = c.roles
  .filter((r) => r.kind !== 'exam' && !r.variantOf)
  .map((r) => ({ id: r.id, title: r.title, family: r.family, hire: r.tiers.hire }));
const net = buildNetwork(c.concepts, c.families, jobs);

// Geometry, in SVG units.
const LABELS = 8; // left margin
const COL = 250;
const TOP = 92; // first station row
const ROW = 42;
const LINE_W = 6;
const x = (i: number) => LABELS + 22 + i * COL;
const y = (row: number) => TOP + row * ROW;
const col = new Map(net.lines.map((l, i) => [l.id, i]));

/** Greedy word wrap. Station and role names are short, so two lines is plenty. */
function wrap(text: string, max: number): string[] {
  const out: string[] = [];
  for (const w of text.split(' ')) {
    const last = out[out.length - 1];
    if (last !== undefined && (last + ' ' + w).length <= max) out[out.length - 1] = last + ' ' + w;
    else out.push(w);
  }
  return out;
}

// Termini hang under each line, one under another.
const termTop = y(net.rows - 1) + 56;
const TERM_LINE = 19;
const TERM_GAP = 14;
const termini = net.lines.map((l, i) => {
  let at = termTop;
  return l.roles.map((r) => {
    const lines = wrap(r.title, 25);
    const top = at;
    at += lines.length * TERM_LINE + TERM_GAP;
    return { ...r, line: l.id, lines, x: x(i), y: top + 9 };
  });
});
const lineEnd = termini.map((ts) => ts[ts.length - 1]!.y);
const height = Math.max(...termini.flat().map((t) => t.y + (t.lines.length - 1) * TERM_LINE)) + 24;
const width = LABELS + net.lines.length * COL + 16;

// Where a line runs past an interchange without stopping, it's drawn over
// the link with a gap, like a bridge.
const bridges: Array<{ line: string; x: number; y: number; station: string }> = net.stations
  .filter((s) => s.interchange)
  .flatMap((s) => {
    const cols = s.lines.map((l) => col.get(l)!);
    const lo = Math.min(...cols);
    const hi = Math.max(...cols);
    return net.lines.filter((_, i) => i > lo && i < hi && !cols.includes(i)).map((l) => ({ line: l.id, x: x(col.get(l.id)!), y: y(s.row), station: s.id }));
  });

// An interchange's name sits inside its link, in the first gap between
// the circles and bridges, which is always a whole column wide.
const nameAt = (id: string, xs: number[]) => {
  const crossings = [...xs, ...bridges.filter((b) => b.station === id).map((b) => b.x)].sort((a, b) => a - b);
  return crossings[0]! + 16;
};

// What the job card needs, inlined for the script.
const cardData = {
  lines: Object.fromEntries(net.lines.map((l) => [l.id, l.title])),
  stations: net.stations.map((s) => ({ id: s.id, title: s.title, lines: s.lines, roles: s.roles })),
  roles: Object.fromEntries(net.lines.flatMap((l) => l.roles.map((r) => [r.id, { title: r.title, line: l.id }]))),
};
const totalJobs = net.lines.reduce((n, l) => n + l.roles.length, 0);
---

<figure class="netmap" data-netmap>
  {chips && <div class="netmap-chips" role="group" aria-label="Show one line">
    <button type="button" class="line-chip" data-chip="" aria-pressed="true">
      <span class="chip-swatch all" aria-hidden="true"></span>All lines <span class="chip-n num">{totalJobs}</span>
    </button>
    {net.lines.map((l) => (
      <button type="button" class="line-chip" data-chip={l.id} data-line={l.id} aria-pressed="false">
        <span class="chip-swatch" aria-hidden="true"></span>{l.title} <span class="chip-n num">{l.roles.length}</span>
      </button>
    ))}
  </div>}
  <div class="netmap-view" data-view>
  <div class="netmap-world" data-world>
  <svg viewBox={`0 0 ${width} ${height}`} role="group" aria-labelledby="netmap-title netmap-desc">
    <title id="netmap-title">The Terminus network</title>
    <desc id="netmap-desc">
      {net.lines.length} lines, one for each family of jobs. Each line ends at its jobs. Stations are the stops most of a
      line's jobs need; interchanges are stops two or more lines share.
    </desc>

    {/* Line names, like the coloured boards above a platform. */}
    {net.lines.map((l, i) => (
      <g class="line-head" data-line={l.id}>
        <rect x={x(i) - 14} y="8" width={COL - 34} height="36" />
        <text x={x(i) - 2} y="33">{l.title}</text>
      </g>
    ))}

    {/* The lines themselves, down to the last terminus. */}
    {net.lines.map((l, i) => (
      <path class="line trunk" data-line={l.id} d={`M${x(i)} 42V${lineEnd[i]}`} stroke-width={LINE_W} pathLength="1" style={`--n:${i}`} />
    ))}

    {/* Interchanges: a link across every line that calls there. */}
    {net.stations.filter((s) => s.interchange).map((s) => {
      const xs = s.lines.map((l) => x(col.get(l)!));
      const left = Math.min(...xs);
      const right = Math.max(...xs);
      return (
        <g class="st inter" data-id={s.id} data-roles={s.roles.join(' ')} data-lines={s.lines.join(' ')}>
          <rect class="link" x={left - 15} y={y(s.row) - 15} width={right - left + 30} height="30" rx="15" />
          {xs.map((sx) => <circle cx={sx} cy={y(s.row)} r="7" />)}
          <text class="inter-name" x={nameAt(s.id, xs)} y={y(s.row) + 5.5}>{s.title}</text>
        </g>
      );
    })}
    {bridges.map((b) => (
      <g class="bridge" data-line={b.line}>
        <path class="bridge-gap" d={`M${b.x} ${b.y - 18}V${b.y + 18}`} />
        <path class="line" data-line={b.line} d={`M${b.x} ${b.y - 18}V${b.y + 18}`} stroke-width={LINE_W} />
      </g>
    ))}

    {/* Stations on one line only. */}
    {net.stations.filter((s) => !s.interchange).map((s) => {
      const sx = x(col.get(s.lines[0]!)!);
      const sy = y(s.row);
      const lines = wrap(s.title, 25);
      return (
        <g class="st" data-id={s.id} data-roles={s.roles.join(' ')} data-lines={s.lines.join(' ')} data-line={s.lines[0]}>
          <circle cx={sx} cy={sy} r="7" />
          <text x={sx + 15} y={lines.length > 1 ? sy - 3 : sy + 5}>
            {lines.map((t, i) => <tspan x={sx + 15} dy={i === 0 ? 0 : 18}>{t}</tspan>)}
          </text>
        </g>
      );
    })}

    {/* Termini: one per job. */}
    {termini.flat().map((t) => (
      <a class="terminus" href={`/roles/${t.id}`} data-role={t.id} data-line={t.line}>
        <path class="line" data-line={t.line} d={`M${t.x - LINE_W / 2} ${t.y}H${t.x + 16}`} stroke-width={LINE_W} />
        <rect class="bar" x={t.x + 15} y={t.y - 11} width="7" height="22" />
        <text x={t.x + 31} y={t.y + 6}>
          {t.lines.map((s, i) => <tspan x={t.x + 31} dy={i === 0 ? 0 : TERM_LINE}>{s}</tspan>)}
        </text>
        <text class="here" x={t.x + 31} y={t.y - 16} aria-hidden="true">You are here</text>
      </a>
    ))}
  </svg>
  </div>
    <div class="netmap-zoom" data-nodrag>
      <button type="button" data-zoom="out" aria-label="Zoom out">&minus;</button>
      <span class="num" data-zoom-level aria-live="polite">100%</span>
      <button type="button" data-zoom="in" aria-label="Zoom in">+</button>
      <button type="button" data-zoom="fit" class="zoom-fit">Whole map</button>
    </div>
    <p class="netmap-hint" data-hint data-nodrag hidden>
      Pick a job to see its line and where you can change. Zoom in with + to read it closer, then drag to move around.
      <button type="button" data-hint-close>Got it</button>
    </p>
    <aside class="netmap-card" data-card data-nodrag tabindex="-1" aria-labelledby="netmap-card-board" aria-hidden="true">
      <div class="card-top">
        <span class="card-line" data-card-line></span>
        <button type="button" class="card-close" data-card-close aria-label="Close">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" /></svg>
        </button>
      </div>
      <p><span class="board card-board" id="netmap-card-board" data-card-title></span></p>
      <h3>Its hiring list calls at</h3>
      <ul class="card-stops" data-card-stops></ul>
      <h3>Change here to</h3>
      <ul class="card-changes" data-card-changes></ul>
      <div class="card-actions">
        <a class="btn card-go" data-card-go href="/roles" data-board-from="#netmap-card-board">See the route</a>
        {!chips && <button type="button" class="text-button" data-card-show-line>Show its line</button>}
      </div>
    </aside>
  </div>
  <script type="application/json" id="netmap-data" set:html={JSON.stringify(cardData)} />

  <figcaption class="netmap-key">
    <span><svg viewBox="0 0 44 20" aria-hidden="true"><rect class="key-link" x="2" y="3" width="40" height="14" rx="7" /></svg>An interchange: a stop two or more lines share, where you can change careers.</span>
    <span><svg viewBox="0 0 20 20" aria-hidden="true"><circle class="key-st" cx="10" cy="10" r="6" /></svg>A stop most of that line's jobs need.</span>
    <span><svg viewBox="0 0 20 20" aria-hidden="true"><circle class="key-passed" cx="10" cy="10" r="6" /></svg>Already behind you. Pick where you're starting from in the ticket at the top.</span>
    <span><svg viewBox="0 0 20 22" aria-hidden="true"><rect class="key-bar" x="7" y="1" width="7" height="20" /></svg>A job. Pick one to plan your route there.</span>
  </figcaption>
</figure>

<script>
  interface CardData {
    lines: Record<string, string>;
    stations: Array<{ id: string; title: string; lines: string[]; roles: string[] }>;
    roles: Record<string, { title: string; line: string }>;
  }

  const map = document.querySelector<HTMLElement>('[data-netmap]');
  if (map) {
    const data: CardData = JSON.parse(document.getElementById('netmap-data')!.textContent!);
    const stations = [...map.querySelectorAll<SVGGElement>('.st')];
    const termini = [...map.querySelectorAll<SVGAElement>('.terminus')];
    const lined = [...map.querySelectorAll<SVGElement>('svg [data-line]')];
    const chips = [...map.querySelectorAll<HTMLButtonElement>('[data-chip]')];
    const view = map.querySelector<HTMLElement>('[data-view]')!;
    const world = map.querySelector<HTMLElement>('[data-world]')!;
    const level = map.querySelector<HTMLElement>('[data-zoom-level]')!;
    const card = map.querySelector<HTMLElement>('[data-card]')!;
    const hint = map.querySelector<HTMLElement>('[data-hint]')!;
    const motion = () => document.documentElement.classList.contains('motion');

    let known = new Set<string>();
    let from: string | undefined;
    let fromParam = '';
    let filter: string | null = null;
    let picked: string | null = null;
    let pickedFrom: SVGAElement | null = null;

    // Light up a job, a line, or nothing. Hover wins, then the open card, then the chosen line.
    const light = (role: string | null, line: string | null) => {
      map.classList.toggle('focusing', role !== null || line !== null);
      for (const s of stations) {
        const on = role !== null ? (s.dataset.roles ?? '').split(' ').includes(role) : line !== null && (s.dataset.lines ?? '').split(' ').includes(line);
        s.classList.toggle('on', on);
      }
      for (const t of termini) t.classList.toggle('on', role !== null ? t.dataset.role === role : t.dataset.line === line);
      for (const el of lined) if (!el.closest('.terminus, .st')) el.classList.toggle('on', el.dataset.line === line);
    };
    const rest = () => {
      if (picked) light(picked, data.roles[picked]!.line);
      else light(null, filter);
    };
    for (const t of termini) {
      const on = () => light(t.dataset.role!, t.dataset.line!);
      t.addEventListener('pointerenter', on);
      t.addEventListener('pointerleave', rest);
      t.addEventListener('focus', on);
      t.addEventListener('blur', rest);
    }

    // Show one line.
    for (const c of chips) {
      c.addEventListener('click', () => {
        filter = c.dataset.chip || null;
        chips.forEach((x) => x.setAttribute('aria-pressed', String(x === c)));
        closeCard(false);
        rest();
        if (filter && z > 1) {
          const head = map.querySelector<SVGGElement>(`.line-head[data-line="${filter}"]`)!;
          const box = head.getBoundingClientRect();
          const v = view.getBoundingClientRect();
          setView(z, px + (v.left + v.width / 2) - (box.left + box.width / 2), py);
        }
      });
    }

    // Zoom and drag. At 100% the whole map fits; zoom in to read it closer.
    let z = 1;
    let px = 0;
    let py = 0;
    const MIN = 1;
    // Phones need to zoom much further to read a map drawn for a wide screen.
    const MAX = matchMedia('(max-width: 760px)').matches ? 6 : 2.6;
    const setView = (nz: number, nx: number, ny: number, animate = true) => {
      z = Math.min(MAX, Math.max(MIN, nz));
      const w = view.clientWidth;
      const h = world.offsetHeight;
      px = Math.min(0, Math.max(w - w * z, nx));
      py = Math.min(0, Math.max(h - h * z, ny));
      world.classList.toggle('settle', animate);
      world.style.transform = `translate(${px}px, ${py}px) scale(${z})`;
      level.textContent = `${Math.round(z * 100)}%`;
      view.classList.toggle('zoomed', z > 1);
    };
    const zoomBy = (k: number) => {
      const cx = view.clientWidth / 2;
      const cy = Math.min(world.offsetHeight, innerHeight) / 2;
      const nz = Math.min(MAX, Math.max(MIN, z * k));
      const r = nz / z;
      setView(nz, cx - (cx - px) * r, cy - (cy - py) * r);
    };
    map.querySelector('[data-zoom="in"]')!.addEventListener('click', () => zoomBy(1.35));
    map.querySelector('[data-zoom="out"]')!.addEventListener('click', () => zoomBy(1 / 1.35));
    map.querySelector('[data-zoom="fit"]')!.addEventListener('click', () => setView(1, 0, 0));
    addEventListener('resize', () => setView(z, px, py, false));

    let drag: { x: number; y: number; px: number; py: number; moved: boolean } | null = null;
    let dragged = false;
    view.addEventListener('pointerdown', (e) => {
      if (z <= 1 || (e.target as Element).closest('[data-nodrag]') || e.button !== 0) return;
      drag = { x: e.clientX, y: e.clientY, px, py, moved: false };
    });
    addEventListener('pointermove', (e) => {
      if (!drag) return;
      const dx = e.clientX - drag.x;
      const dy = e.clientY - drag.y;
      if (!drag.moved && Math.hypot(dx, dy) < 5) return;
      if (!drag.moved) view.setPointerCapture?.(e.pointerId);
      drag.moved = true;
      view.classList.add('dragging');
      setView(z, drag.px + dx, drag.py + dy, false);
    });
    const endDrag = () => {
      if (drag?.moved) {
        dragged = true;
        setTimeout(() => (dragged = false), 0);
      }
      drag = null;
      view.classList.remove('dragging');
    };
    addEventListener('pointerup', endDrag);
    addEventListener('pointercancel', endDrag);

    // Pick a job: its card slides in, with its stops and where it meets other lines.
    const el = <K extends keyof HTMLElementTagNameMap>(tag: K, cls?: string, text?: string) => {
      const e = document.createElement(tag);
      if (cls) e.className = cls;
      if (text !== undefined) e.textContent = text;
      return e;
    };
    const list = (xs: string[]) => (xs.length <= 1 ? xs[0] ?? '' : `${xs.slice(0, -1).join(', ')} and ${xs[xs.length - 1]}`);
    const openCard = (role: string, trigger: SVGAElement) => {
      const r = data.roles[role]!;
      picked = role;
      pickedFrom = trigger;
      card.dataset.line = r.line;
      card.querySelector('[data-card-line]')!.textContent = `${data.lines[r.line]} line`;
      card.querySelector('[data-card-title]')!.textContent = r.title;
      const mine = data.stations.filter((s) => s.roles.includes(role));
      const ul = card.querySelector('[data-card-stops]')!;
      ul.replaceChildren(
        ...mine.map((s) => {
          const li = el('li', known.has(s.id) ? 'is-passed' : undefined, s.title);
          if (known.has(s.id)) li.title = 'Already behind you';
          return li;
        }),
      );
      if (mine.length === 0) ul.append(el('li', 'is-none', 'None of the stations on this map; see the route for its stops.'));
      const changes = new Map<string, string[]>();
      for (const s of mine) for (const l of s.lines) if (l !== r.line) changes.set(l, [...(changes.get(l) ?? []), s.title]);
      const cl = card.querySelector('[data-card-changes]')!;
      cl.replaceChildren(
        ...[...changes].map(([l, via]) => {
          const li = el('li');
          li.dataset.line = l;
          li.append(el('strong', undefined, data.lines[l]), ` through ${list(via)}`);
          return li;
        }),
      );
      if (changes.size === 0) cl.append(el('li', 'is-none', 'None here: this job shares no stations with other lines on the map.'));
      const go = card.querySelector<HTMLAnchorElement>('[data-card-go]')!;
      go.href = `/roles/${role}${fromParam}`;
      card.classList.add('open');
      card.setAttribute('aria-hidden', 'false');
      termini.forEach((t) => t.classList.toggle('picked', t === trigger));
      rest();
      card.focus({ preventScroll: true });
      closeHint();
    };
    const closeCard = (refocus = true) => {
      if (!picked) return;
      picked = null;
      card.classList.remove('open');
      card.setAttribute('aria-hidden', 'true');
      termini.forEach((t) => t.classList.remove('picked'));
      rest();
      if (refocus) pickedFrom?.focus({ preventScroll: true });
    };
    for (const t of termini) {
      t.addEventListener('click', (e) => {
        if (e.metaKey || e.ctrlKey || e.shiftKey || (e as MouseEvent).button !== 0) return;
        e.preventDefault();
        if (dragged) return;
        if (picked === t.dataset.role) closeCard();
        else openCard(t.dataset.role!, t);
      });
    }
    card.querySelector('[data-card-close]')!.addEventListener('click', () => closeCard());
    // On the home page the chips live outside the map: hand over to the line view.
    card.querySelector('[data-card-show-line]')?.addEventListener('click', () => {
      if (picked) document.dispatchEvent(new CustomEvent('terminus:show-line', { detail: { role: picked } }));
    });
    card.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeCard(); });

    // First visit: a short note on how the map works.
    const HINT = 'terminus:map-hint';
    const closeHint = () => {
      hint.hidden = true;
      try { localStorage.setItem(HINT, '1'); } catch {}
    };
    try { hint.hidden = localStorage.getItem(HINT) === '1'; } catch { hint.hidden = false; }
    hint.querySelector('[data-hint-close]')!.addEventListener('click', closeHint);

    // The lines draw themselves the first time the map comes into view.
    if (motion() && 'IntersectionObserver' in window) {
      map.classList.add('undrawn');
      const io = new IntersectionObserver(([e]) => {
        if (!e!.isIntersecting) return;
        map.classList.remove('undrawn');
        io.disconnect();
      }, { threshold: 0.15 });
      io.observe(view);
    }

    // The home page ticket says what's already behind you.
    document.addEventListener('terminus:ticket', (e) => {
      const d = (e as CustomEvent<{ known: string[]; from?: string; fromId?: string }>).detail;
      known = new Set(d.known);
      from = d.from;
      fromParam = d.fromId ? `?from=${encodeURIComponent(d.fromId)}` : '';
      for (const s of stations) s.classList.toggle('passed', known.has(s.dataset.id!));
      for (const t of termini) t.classList.toggle('here', t.dataset.role === from);
      if (picked && pickedFrom) openCard(picked, pickedFrom);
    });
  }
</script>

<style>
  .netmap { margin: 18px 0 0; }
  .netmap-chips { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 12px; }
  .line-chip {
    display: inline-flex; align-items: center; gap: 8px; min-height: 40px; padding: 4px 12px 1px;
    border: 2px solid var(--ink); background: var(--paper); color: var(--ink);
    font-family: var(--sign); font-stretch: 88%; font-weight: 680; font-size: 1.08rem; line-height: 1;
    transition: background-color 0.2s ease, color 0.2s ease, transform 0.15s ease;
  }
  .line-chip:hover { transform: translateY(-2px); }
  .line-chip[aria-pressed='true'] { background: var(--ink); color: var(--paper); }
  .chip-swatch { width: 16px; height: 6px; margin-top: -3px; background: var(--c); }
  .chip-swatch.all { background: var(--yellow); }
  .chip-n { font-family: var(--text); font-size: 0.82rem; font-weight: 700; margin-top: -2px; opacity: 0.8; }

  .netmap-view {
    position: relative; overflow: hidden; border: 3px solid var(--ink); background: var(--paper);
    padding: 0; touch-action: pan-y;
  }
  .netmap-view.zoomed { cursor: grab; touch-action: none; }
  .netmap-view.dragging { cursor: grabbing; user-select: none; }
  .netmap-world { transform-origin: 0 0; padding: 6px 10px 10px; }
  .netmap-world.settle { transition: transform 0.45s cubic-bezier(0.2, 0.7, 0.2, 1); }

  .netmap-zoom {
    position: absolute; right: 12px; bottom: 12px; z-index: 3; display: flex; align-items: center;
    border: 2px solid var(--ink); background: var(--paper); cursor: default;
  }
  .netmap-zoom button {
    min-width: 40px; height: 40px; border: 0; background: var(--paper); color: var(--ink);
    font-size: 1.3rem; line-height: 1; transition: background-color 0.15s;
  }
  .netmap-zoom button:hover { background: var(--yellow); color: #000; }
  .netmap-zoom span { min-width: 52px; text-align: center; font-size: 0.85rem; font-weight: 700; border-left: 2px solid var(--ink); border-right: 2px solid var(--ink); line-height: 40px; }
  .netmap-zoom .zoom-fit { font-family: var(--sign); font-stretch: 88%; font-weight: 700; font-size: 1.05rem; padding: 3px 12px 0; border-left: 2px solid var(--ink); }

  .netmap-hint {
    position: absolute; left: 12px; bottom: 12px; z-index: 3; max-width: min(430px, calc(100% - 300px));
    display: flex; align-items: center; gap: 14px; padding: 10px 10px 10px 14px;
    background: #111; color: #f3f1ea; font-size: 0.92rem; line-height: 1.4; cursor: default;
