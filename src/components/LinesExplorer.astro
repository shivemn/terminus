---
// "Where could you go?" on the home page. One chip per line (a family of
// jobs), a search box, and three views of the same jobs:
//   - All lines on the map: the whole network, with its interchanges.
//   - One line: its stops, where it meets other lines, its jobs, and a card
//     for the job you pick. The card works out your own route from the ticket.
//   - A list: every route by family, with whether it has been checked against
//     real listings. Phones start here; searching always shows it.
// Everything is drawn at build time. The script only switches views, fills the
// card, and greys out what the ticket says is behind you.
import NetworkMap from './NetworkMap.astro';
import { buildNetwork } from '../lib/network';
import { content, listOf } from '../lib/site';

const c = content();
const routes = c.roles.filter((r) => r.kind !== 'exam' && !r.variantOf);
const net = buildNetwork(
  c.concepts,
  c.families,
  routes.map((r) => ({ id: r.id, title: r.title, family: r.family, hire: r.tiers.hire })),
);
const title = (id: string) => c.concepts.find((x) => x.id === id)?.title ?? id;
const byId = new Map(c.roles.map((r) => [r.id, r]));
const shortName = new Map(net.lines.map((l) => [l.id, l.title]));
const station = new Map(net.stations.map((s) => [s.id, s]));

const lines = net.lines.map((l) => {
  const stops = l.stations.map((id) => {
    const s = station.get(id)!;
    const others = s.lines.filter((x) => x !== l.id).map((x) => shortName.get(x)!);
    return { id, title: s.title, inter: s.interchange, change: others.length ? `Change for ${listOf(others)}` : '' };
  });
  const meets = new Set(stops.flatMap((s) => station.get(s.id)!.lines.filter((x) => x !== l.id)));
  const fam = c.families.find((f) => f.id === l.id)!;
  return {
    id: l.id,
    short: l.title,
    full: fam.title,
    stops,
    meets: meets.size,
    jobs: l.roles.map((r) => ({ id: r.id, title: r.title })),
    desc: `${l.roles.length} ${l.roles.length === 1 ? 'route' : 'routes'} on this line. Most of their hiring lists call at ${listOf(stops.map((s) => s.title))}.`,
  };
});

// Job titles that build on a route (Python developer on Backend engineer), for search.
const variants = c.roles.filter((r) => r.variantOf && r.kind !== 'exam');
const list = lines.map((l) => ({
  ...l,
  rows: l.jobs.flatMap((j) => {
    const r = byId.get(j.id)!;
    return [
      { id: j.id, title: j.title, route: true, checked: !!r.evidence },
      ...variants.filter((v) => v.variantOf === j.id).map((v) => ({ id: v.id, title: v.title, route: false, checked: !!r.evidence, of: j.title })),
    ];
  }),
}));

const cardData = {
  lines: Object.fromEntries(lines.map((l) => [l.id, { meets: l.meets, first: l.jobs[0]!.id }])),
  roles: Object.fromEntries(
    lines.flatMap((l) =>
      l.jobs.map((j) => {
        const r = byId.get(j.id)!;
        return [j.id, { t: r.title, s: r.summary, l: l.id, c: r.evidence?.postings ?? 0, h: r.tiers.hire.map((id) => [id, title(id)]) }];
      }),
    ),
  ),
};
const total = lines.reduce((n, l) => n + l.jobs.length, 0);
---

<div class="lx" data-lx>
  <div class="lx-tools" data-reveal>
    <label class="lx-search">
      <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="M20 20l-4-4" /></svg>
      <span class="visually-hidden">Find a job</span>
      <input type="search" placeholder="Find a job, like analyst or engineer" autocomplete="off" data-lx-q />
    </label>
    <div class="lx-switch" role="group" aria-label="View">
      <button type="button" data-lx-view="map" aria-pressed="true">Map</button>
      <button type="button" data-lx-view="list" aria-pressed="false">List</button>
    </div>
  </div>

  <div class="lx-chips" role="group" aria-label="Lines" data-reveal style="--delay: 0.06s">
    <button type="button" class="lx-chip" data-lx-chip="" aria-pressed="true">
      <span class="lx-swatch all" aria-hidden="true"></span>All lines <span class="lx-n num">{total}</span>
    </button>
    {lines.map((l) => (
      <button type="button" class="lx-chip" data-lx-chip={l.id} data-line={l.id} aria-pressed="false">
        <span class="lx-swatch" aria-hidden="true"></span>{l.short} <span class="lx-n num">{l.jobs.length}</span>
      </button>
    ))}
  </div>

  <div class="lx-map" data-lx-pane="map" data-reveal style="--delay: 0.1s">
    <NetworkMap chips={false} />
  </div>

  <div class="lx-line" data-lx-pane="line" hidden>
    {lines.map((l) => (
      <div class="lp" data-lp={l.id} data-line={l.id} hidden>
        <div class="lp-left">
          <p class="lp-kicker">Selected line</p>
          <h3 class="lp-title"><span class="lp-bar" aria-hidden="true"></span>{l.full}</h3>
          <p class="lp-desc">{l.desc}</p>
          <ul class="lp-key">
            <li><span class="k-inter" aria-hidden="true"></span>Shared with another line</li>
            <li><span class="k-stop" aria-hidden="true"></span>On most of its hiring lists</li>
            <li><span class="k-passed" aria-hidden="true"></span>Behind you, going by your ticket</li>
          </ul>
        </div>
        <div class="lp-mid">
          <div class="lp-stops">
            <p class="lp-kicker">Stops most jobs call at</p>
            <ol class="lp-rail">
              {l.stops.map((s, i) => (
                <li class:list={['lp-st', { inter: s.inter }]} data-stop={s.id} style={`--i:${i}`}>
                  <span class="lp-node" aria-hidden="true"></span>
                  <span><span class="lp-name">{s.title}</span>{s.change && <span class="lp-change">{s.change}</span>}</span>
                </li>
              ))}
            </ol>
          </div>
          <div class="lp-jobs">
            <p class="lp-kicker">{l.jobs.length} {l.jobs.length === 1 ? 'job' : 'jobs'} at the end of the line</p>
            <ul>
              {l.jobs.map((j, i) => (
                <li style={`--i:${i}`}>
                  <button type="button" class="lp-job" data-lx-role={j.id} aria-pressed="false">
                    <span class="lp-jt">{j.title}</span><span class="lp-ja" aria-hidden="true">&rarr;</span>
                  </button>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </div>
    ))}
    <button type="button" class="lx-back" data-lx-close tabindex="-1" aria-label="Close the job card"></button>
    <aside class="lx-card" data-lx-card tabindex="-1" aria-labelledby="lx-board">
      <div class="lx-card-top">
        <p class="lp-kicker">Where the line ends</p>
        <button type="button" class="lx-x" data-lx-close aria-label="Close">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" /></svg>
        </button>
      </div>
      <p><span class="board lx-board" id="lx-board" data-lx-title></span></p>
      <p class="lx-sum" data-lx-sum></p>
      <dl class="lx-facts" data-lx-facts></dl>
      <p class="lp-kicker">Its hiring list</p>
      <ul class="lx-hire" data-lx-hire></ul>
      <a class="lx-go" data-lx-go href="/roles" data-board-from="#lx-board">Plan my route <span aria-hidden="true">&rarr;</span></a>
      <p class="lx-note faint" data-lx-note>Pick where you're starting from in the ticket at the top to see your own route.</p>
    </aside>
  </div>

  <div class="lx-list" data-lx-pane="list" hidden>
    {list.map((l, i) => (
      <details class="lx-fam" data-lx-fam={l.id} data-line={l.id} open={i === 0}>
        <summary><span>{l.short}</span> <span class="lx-n num">{l.jobs.length} {l.jobs.length === 1 ? 'job' : 'jobs'}</span></summary>
        <ul>
          {l.rows.map((r) => (
            <li data-lx-row data-title={r.title.toLowerCase()} data-variant={r.route ? undefined : ''} hidden={!r.route}>
              <a href={`/roles/${r.id}`} data-lx-open={r.route ? r.id : undefined}>
                <span>{r.title}{!r.route && <span class="faint lx-of">, on the {r.of} route</span>}</span>
                <span class:list={['lx-tag', { ok: r.checked }]}>{r.checked ? 'Checked' : 'Draft'}</span>
              </a>
            </li>
          ))}
        </ul>
      </details>
    ))}
    <p class="lx-none" data-lx-none hidden>No job matches that yet. Try a shorter word, like "analyst".</p>
    <p class="faint lx-legend">"Checked" means the route was compared with real entry-level listings. "Draft" means it hasn't been yet.</p>
  </div>
  <script type="application/json" id="lx-data" set:html={JSON.stringify(cardData)} />
</div>

<script is:inline>
  // Phones open on the list. Set before the first paint so nothing jumps.
  (() => {
    const lx = document.currentScript.previousElementSibling;
    if (!matchMedia('(max-width: 760px)').matches) return;
    lx.querySelector('[data-lx-pane="map"]').hidden = true;
    lx.querySelector('[data-lx-pane="list"]').hidden = false;
    lx.querySelectorAll('[data-lx-view]').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.lxView === 'list')));
  })();
</script>

<script>
  import { planPath, type ConceptNode } from '../lib/graph';
  import { duration } from '../lib/coaches';
  import { midSentence } from '../lib/text';

  interface LxData {
    lines: Record<string, { meets: number; first: string }>;
    roles: Record<string, { t: string; s: string; l: string; c: number; h: [string, string][] }>;
  }

  const lx = document.querySelector<HTMLElement>('[data-lx]');
  if (lx) {
    const data: LxData = JSON.parse(document.getElementById('lx-data')!.textContent!);
    const preview = document.getElementById('preview-data');
    const nodes: ConceptNode[] = preview ? JSON.parse(preview.textContent!).nodes : [];
    const $ = <T extends Element = HTMLElement>(s: string) => lx.querySelector<T>(s)!;
    const $$ = <T extends Element = HTMLElement>(s: string) => [...lx.querySelectorAll<T>(s)];
    const panes = { map: $('[data-lx-pane="map"]'), line: $('[data-lx-pane="line"]'), list: $('[data-lx-pane="list"]') };
    const chips = $$<HTMLButtonElement>('[data-lx-chip]');
    const views = $$<HTMLButtonElement>('[data-lx-view]');
    const q = $<HTMLInputElement>('[data-lx-q]');
    const card = $('[data-lx-card]');
    const phone = matchMedia('(max-width: 760px)');
    const motion = () => document.documentElement.classList.contains('motion');

    let view: 'map' | 'list' = phone.matches ? 'list' : 'map';
    let line: string | null = null;
    let role: string | null = null;
    let known = new Set<string>();
    let fromId = '';
    let fromLabel = '';
    let wanted = '';
    let flip = false;

    function render() {
      const query = q.value.trim().toLowerCase();
      const showList = view === 'list' || query !== '';
      panes.map.hidden = showList || line !== null;
      panes.line.hidden = showList || line === null;
      panes.list.hidden = !showList;
      chips.forEach((c) => c.setAttribute('aria-pressed', String((c.dataset.lxChip || null) === line)));
      views.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.lxView === view)));
      if (!panes.line.hidden) $$('[data-lp]').forEach((p) => (p.hidden = p.dataset.lp !== line));
      if (showList) {
        let shown = 0;
        for (const fam of $$<HTMLDetailsElement>('[data-lx-fam]')) {
          let n = 0;
          for (const row of fam.querySelectorAll<HTMLElement>('[data-lx-row]')) {
            const hit = query ? row.dataset.title!.includes(query) : !('variant' in row.dataset);
            row.hidden = !hit;
            if (hit) n++;
          }
          fam.hidden = n === 0 || (!query && line !== null && fam.dataset.lxFam !== line);
          if (query) fam.open = true;
          if (!fam.hidden) shown += n;
        }
        $('[data-lx-none]').hidden = shown > 0;
      }
      if (!panes.map.hidden) dispatchEvent(new Event('resize'));
    }

    // The line draws itself each time it's picked.
    function draw(id: string) {
      const p = $(`[data-lp="${id}"]`);
      p.classList.remove('drawn');
      if (!motion()) return p.classList.add('drawn');
      void p.offsetWidth;
      requestAnimationFrame(() => p.classList.add('drawn'));
    }

    function pickLine(id: string | null, r?: string) {
      line = id;
      if (id) {
        const roles = data.roles;
        role = r ?? (wanted && roles[wanted]?.l === id ? wanted : data.lines[id]!.first);
        render();
        if (!panes.line.hidden) draw(id);
        fill(false);
      } else {
        role = null;
        closeSheet(false);
        render();
      }
    }

    const fmt = (n: number, one: string, many: string) => `${n} ${n === 1 ? one : many}`;
    function fill(animate = true) {
      if (!role) return;
      const r = data.roles[role]!;
      $$<HTMLButtonElement>('[data-lx-role]').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.lxRole === role)));
      $('[data-lx-title]').textContent = r.t;
      $('[data-lx-sum]').textContent = r.s;
      const facts: [string, string][] = [];
      const hire = r.h.map(([id]) => id);
      if (nodes.length) {
        const full = planPath(nodes, hire, new Set());
        if (known.size) {
          const mine = planPath(nodes, hire, known);
          const behind = full.steps.length - mine.steps.length;
          facts.push([`From ${midSentence(fromLabel)}`, behind ? `${fmt(behind, 'stop', 'stops')} behind you` : 'Nothing behind you yet']);
          facts.push(['The rest at 10 hours a week', mine.steps.length ? `${fmt(mine.steps.length, 'stop', 'stops')}, ${duration(mine.totalHours, 10)}` : 'Nothing left']);
        } else {
          facts.push(['From the very beginning', fmt(full.steps.length, 'stop', 'stops')]);
          facts.push(['At 10 hours a week', duration(full.totalHours, 10)]);
        }
      }
      facts.push(['Checked against', r.c ? `${r.c} listings` : 'Not yet (draft)']);
      const meets = data.lines[r.l]!.meets;
      facts.push(['This line meets', meets ? fmt(meets, 'other line', 'other lines') : 'no other lines']);
      $('[data-lx-facts]').replaceChildren(
        ...facts.map(([k, v]) => {
          const row = document.createElement('div');
          const dt = document.createElement('dt');
          const dd = document.createElement('dd');
          dt.textContent = k;
          dd.textContent = v;
          row.append(dt, dd);
          return row;
        }),
      );
      $('[data-lx-hire]').replaceChildren(
        ...r.h.map(([id, t]) => {
          const li = document.createElement('li');
          li.textContent = t;
          if (known.has(id)) {
            li.className = 'passed';
            li.title = 'Already behind you';
          }
          return li;
        }),
      );
      $<HTMLAnchorElement>('[data-lx-go]').href = `/roles/${role}${fromId ? `?from=${encodeURIComponent(fromId)}` : ''}`;
      $('[data-lx-note]').hidden = known.size > 0;
      for (const st of $$(`[data-lp] [data-stop]`)) st.classList.toggle('passed', known.has(st.dataset.stop!));
      if (animate && motion()) {
        flip = !flip;
        card.classList.remove('swap-a', 'swap-b');
        void card.offsetWidth;
        card.classList.add(flip ? 'swap-a' : 'swap-b');
      }
    }

    // On a phone the card is a sheet that slides up from the bottom.
    let opener: HTMLElement | null = null;
    function openSheet(from: HTMLElement | null) {
      if (!phone.matches) return;
      opener = from;
      panes.line.classList.add('sheet-open');
      document.documentElement.classList.add('lx-locked');
      card.focus({ preventScroll: true });
    }
    function closeSheet(refocus = true) {
      if (!panes.line.classList.contains('sheet-open')) return;
      panes.line.classList.remove('sheet-open');
      document.documentElement.classList.remove('lx-locked');
      if (refocus) opener?.focus({ preventScroll: true });
    }

    chips.forEach((c) => c.addEventListener('click', () => {
      pickLine(c.dataset.lxChip || null);
      if (line && phone.matches && view === 'list' && !q.value) {
        // On a phone a chip in the list view opens that family and shows its jobs.
        const fam = $<HTMLDetailsElement>(`[data-lx-fam="${line}"]`);
        fam.open = true;
      }
    }));
    views.forEach((b) => b.addEventListener('click', () => {
      view = b.dataset.lxView as 'map' | 'list';
      q.value = '';
      render();
      if (line && !panes.line.hidden) draw(line);
    }));
    q.addEventListener('input', render);
    $$<HTMLButtonElement>('[data-lx-role]').forEach((b) => b.addEventListener('click', () => {
      role = b.dataset.lxRole!;
      fill();
      openSheet(b);
    }));
    $$<HTMLButtonElement>('[data-lx-close]').forEach((b) => b.addEventListener('click', () => closeSheet()));
    card.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeSheet(); });
    phone.addEventListener('change', () => { if (!phone.matches) closeSheet(false); });

    // A route in the list opens its line, with its card. Variants and modified clicks go to the page.
    $$<HTMLAnchorElement>('[data-lx-open]').forEach((a) => a.addEventListener('click', (e) => {
      if (e.metaKey || e.ctrlKey || e.shiftKey || e.button !== 0) return;
      e.preventDefault();
      const id = a.dataset.lxOpen!;
      view = 'map';
      q.value = '';
      pickLine(data.roles[id]!.l, id);
      lx.scrollIntoView({ behavior: motion() ? 'smooth' : 'auto', block: 'start' });
      openSheet(a);
    }));

    // "Show its line" on the map's job card.
    document.addEventListener('terminus:show-line', (e) => {
      const id = (e as CustomEvent<{ role: string }>).detail.role;
      if (data.roles[id]) pickLine(data.roles[id]!.l, id);
    });

    // The ticket says where you're starting and where you want to go.
    document.addEventListener('terminus:ticket', (e) => {
      const d = (e as CustomEvent<{ known: string[]; fromId?: string; fromLabel?: string; to?: string }>).detail;
      known = new Set(d.known);
      fromId = d.fromId ?? '';
      fromLabel = d.fromLabel ?? '';
      wanted = d.to ?? '';
      fill(false);
      for (const st of $$(`[data-lp] [data-stop]`)) st.classList.toggle('passed', known.has(st.dataset.stop!));
    });

    render();
  }
</script>

<style>
  .lx { margin-top: 30px; }
  .visually-hidden { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  .lx-tools { display: flex; flex-wrap: wrap; gap: 10px; }
  .lx-search {
    flex: 1 1 280px; display: flex; align-items: center; gap: 10px; min-height: 50px; padding: 0 14px;
    border: 2px solid var(--ink); background: var(--paper);
  }
  .lx-search svg { width: 18px; height: 18px; flex: none; fill: none; stroke: currentColor; stroke-width: 2.4; stroke-linecap: round; }
  .lx-search input { flex: 1; min-width: 0; height: 46px; border: 0; background: none; font: inherit; color: var(--ink); outline: none; }
  .lx-search:focus-within { outline: 3px solid var(--focus); outline-offset: 2px; }
  .lx-switch { display: flex; border: 2px solid var(--ink); }
  .lx-switch button {
    min-width: 76px; min-height: 50px; padding: 4px 16px 0; border: 0; background: var(--paper); color: var(--ink);
    font-family: var(--sign); font-stretch: 85%; font-weight: 720; font-size: 1.2rem; transition: background-color 0.2s ease, color 0.2s ease;
  }
  .lx-switch button + button { border-left: 2px solid var(--ink); }
  .lx-switch button[aria-pressed='true'] { background: var(--ink); color: var(--paper); }

  .lx-chips {
    display: flex; gap: 8px; margin-top: 12px; overflow-x: auto; scroll-snap-type: x mandatory; padding: 2px 2px 10px;
    scrollbar-width: thin;
  }
  .lx-chip {
    flex: none; scroll-snap-align: start; display: inline-flex; align-items: center; gap: 9px; min-height: 48px; padding: 5px 16px 1px;
    border: 2px solid var(--ink); background: var(--paper); color: var(--ink);
    font-family: var(--sign); font-stretch: 88%; font-weight: 680; font-size: 1.18rem; line-height: 1;
    transition: background-color 0.2s ease, color 0.2s ease, transform 0.15s ease;
  }
  .lx-chip:hover { transform: translateY(-2px); }
  .lx-chip[aria-pressed='true'] { background: var(--ink); color: var(--paper); }
  .lx-swatch { width: 6px; height: 22px; margin-top: -4px; background: var(--c); }
  .lx-swatch.all { background: var(--yellow); }
  .lx-n { font-family: var(--text); font-size: 0.82rem; font-weight: 700; margin-top: -2px; opacity: 0.8; }
  .lx-map { margin-top: 6px; }
  .lx-map :global(.netmap) { margin-top: 0; }

  /* One line: who it is, its stops and jobs, and the card for the job you pick. */
  .lx-line {
    position: relative; display: grid; grid-template-columns: minmax(0, 270px) minmax(0, 1fr) minmax(0, 340px);
    margin-top: 6px; min-height: 520px; border: 3px solid var(--ink); background: var(--paper); box-shadow: 8px 8px 0 var(--ink);
    animation: rise 0.3s ease;
  }
  .lx-line[hidden] { display: none; }
  .lp:not([hidden]) { display: contents; }
  .lp-kicker { font-family: var(--sign); font-stretch: 85%; font-weight: 650; font-size: 1rem; letter-spacing: 0.04em; text-transform: uppercase; color: var(--ink-2); }
  .lp-left { padding: 26px 24px; border-right: 1.5px solid var(--ink); }
  .lp-title { display: flex; gap: 12px; align-items: flex-start; margin-top: 6px; font-size: clamp(1.9rem, 2.8vw, 2.5rem); font-weight: 700; line-height: 0.98; }
  .lp-bar { flex: none; width: 8px; height: 0.9em; margin-top: 0.02em; background: var(--c); }
  .lp-desc { margin-top: 12px; font-size: 0.95rem; color: var(--ink-2); }
  .lp-key { list-style: none; padding: 14px 0 0; margin: 18px 0 0; border-top: 1.5px solid var(--rule); display: grid; gap: 8px; font-size: 0.88rem; color: var(--ink-2); }
  .lp-key li { display: flex; align-items: center; gap: 10px; }
  .lp-key span { flex: none; width: 16px; height: 16px; margin: 0 5px; border: 3px solid var(--c); border-radius: 50%; }
  .lp-key .k-inter { width: 26px; margin: 0; border-color: var(--ink); border-radius: 8px; }
  .lp-key .k-passed { border-color: var(--ink-3); background: var(--ink-3); }

  .lp-mid {
    display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr); gap: 22px 34px; align-items: stretch;
    padding: 28px 26px; background-color: var(--paper);
    background-image: linear-gradient(color-mix(in srgb, var(--ink) 6%, transparent) 1px, transparent 1px), linear-gradient(90deg, color-mix(in srgb, var(--ink) 6%, transparent) 1px, transparent 1px);
    background-size: 24px 24px;
  }
  .lp-stops { position: relative; }
  .lp-rail { position: relative; list-style: none; padding: 0; margin: 14px 0 0; }
  /* The line itself, and the branch across to the jobs. */
  .lp-rail::before {
