---
import Base from '../../layouts/Base.astro';
import MediaIcon from '../../components/MediaIcon.astro';
import { content, listOf } from '../../lib/site';
import { MEDIA } from '../../lib/schema';
import { stopDetails } from '../../lib/stops';

const c = content();
const byId = new Map(c.concepts.map((x) => [x.id, x]));
const details = new Map(stopDetails(c).map((d) => [d.id, d]));
const HAVE = { read: 'something to read', watch: 'a video course', practice: 'somewhere to practise' } as const;
const LABEL = { read: 'Read', watch: 'Watch', practice: 'Practise' } as const;

const shelves = c.toolGroups.map((g) => ({
  ...g,
  items: g.tools.map((id) => {
    const t = byId.get(id)!;
    const d = details.get(id)!;
    return {
      ...t,
      first: t.requires.map((r) => byId.get(r)!.title),
      have: MEDIA.filter((m) => d.picks[m]),
    };
  }),
}));
const count = shelves.reduce((n, s) => n + s.items.length, 0);
---

<Base
  wide
  title="Tools"
  description="Languages, databases, frameworks and cloud tools, each with a free book, a video course, somewhere to practise, and what to learn first."
>
  <header class="k-head">
    <div class="k-head-id">
      <h1><span class="board">Tools</span></h1>
      <p class="k-lede">
        Need one thing for your job, an interview or a project? Pick it from these {count}. Each one points to the free book
        or guide, video course and practice we'd use, and works out what you need to learn first from what you already know.
      </p>
    </div>
    <dl class="k-glance">
      <div><dt>Tools</dt><dd class="k-big num">{count}</dd></div>
      <div><dt>Shelves</dt><dd class="k-big num">{shelves.length}</dd></div>
      <div><dt>Each one has</dt><dd class="have-key">{MEDIA.map((m) => <span><MediaIcon medium={m} /> {LABEL[m]}</span>)}</dd></div>
    </dl>
  </header>

  <nav class="k-chips" aria-label="Shelves">
    {shelves.map((s) => <a class="k-chip" href={`#shelf-${s.id}`}><i></i>{s.title} <b>{s.items.length}</b></a>)}
  </nav>

  {
    shelves.map((s, si) => (
      <section class="k-sec" aria-labelledby={`shelf-${s.id}`} id={`shelf-${s.id}`}>
        <p class="k-label"><span class="k-n">{String(si + 1).padStart(2, '0')}</span>{s.title}</p>
        <ul class="k-grid shelf">
          {s.items.map((t) => (
            <li data-area={t.area}>
              <div class="k-card" style="--c: var(--line)">
                <div class="k-card-top">
                  <a class="k-card-t" href={`/tools/${t.id}`}>{t.title}</a>
                  <span class="k-tag num">{t.hours} h</span>
                </div>
                <p class="k-card-s tool-summary">{t.summary}</p>
                <div class="k-card-f">
                  <span class="kit" aria-label={`Has ${listOf(t.have.map((m) => HAVE[m]))}`}>
                    {MEDIA.map((m) => (
                      <span class:list={['kit-icon', { off: !t.have.includes(m) }]}>
                        <MediaIcon medium={m} />
                      </span>
                    ))}
                  </span>
                  <span>{t.first.length > 0 ? `After ${listOf(t.first)}` : 'No prerequisites'}</span>
                </div>
              </div>
            </li>
          ))}
        </ul>
      </section>
    ))
  }
</Base>

<style>
  .k-sec:first-of-type { margin-top: 48px; }
  .shelf { grid-template-columns: repeat(auto-fill, minmax(min(100%, 280px), 1fr)); }
  .tool-summary { display: -webkit-box; -webkit-line-clamp: 4; -webkit-box-orient: vertical; overflow: hidden; }
  .have-key { display: flex; flex-wrap: wrap; gap: 4px 14px; font-size: 0.9rem; }
  .have-key span { display: inline-flex; align-items: center; gap: 6px; }
  .have-key :global(svg) { width: 18px; height: 18px; fill: none; stroke: var(--ink); stroke-width: 2; }
  .have-key :global(svg .fill) { fill: var(--ink); stroke: none; }
  .kit { display: inline-flex; gap: 4px; }
  /* The icons come from a child component, so these reach in with :global. */
  .kit-icon :global(svg) { width: 18px; height: 18px; fill: none; stroke: var(--line); stroke-width: 2; display: block; }
  .kit-icon :global(svg .fill) { fill: var(--line); stroke: none; }
  .kit-icon.off :global(svg) { stroke: var(--rule); }
  .kit-icon.off :global(svg .fill) { fill: var(--rule); }
</style>
