---
import Base from '../layouts/Base.astro';
import { content } from '../lib/site';
import { certificationGroups, costLabel } from '../lib/certifications';

const c = content();
const roleById = new Map(c.roles.map((r) => [r.id, r]));
const withRoutes = (list: typeof c.certifications) =>
  list.map((x) => ({ ...x, jobs: x.routes.map((id) => ({ id, title: roleById.get(id)!.title, family: roleById.get(id)!.family })) }));

const free = withRoutes(c.certifications.filter((x) => x.cost === 'free'));
const sections = () => [{ id: 'free', title: 'Free', note: 'No exam fee. Some need a free account.', items: free }, ...paid.map((g) => ({ id: `cert-${g.id}`, title: g.title, note: '', items: g.items }))];
const paid = certificationGroups(c.certifications.filter((x) => x.cost !== 'free')).map((g) => ({ ...g, items: withRoutes(g.items) }));
---

<Base
  wide
  title="Certifications"
  description="Free certificates, and the paid ones Indian recruiters ask for by name, with what each costs and which jobs it helps."
>
  <header class="k-head">
    <div class="k-head-id">
      <h1><span class="board">Certifications</span></h1>
      <p class="k-lede">
        A certificate won't get you hired on its own; what you can show and explain does. But some are asked for by name in job
        posts, and some are free and quick enough to be worth doing on the way. These are those.
      </p>
    </div>
    <dl class="k-glance">
      <div><dt>Certifications</dt><dd class="k-big num">{c.certifications.length}</dd></div>
      <div><dt>Free ones</dt><dd class="k-big num">{free.length}</dd></div>
      <div><dt>Prices</dt><dd class="k-card-m">From each issuer's own page in November 2026. They change, so check before you pay.</dd></div>
    </dl>
  </header>

  <nav class="k-chips" aria-label="Sections">
    {sections().map((g, i) => <a class:list={['k-chip', { on: i === 0 }]} href={`#${g.id}`}><i></i>{g.title} <b>{g.items.length}</b></a>)}
  </nav>

  {
    sections().map((g, gi) => (
      <section class="k-sec" id={g.id} aria-labelledby={`${g.id}-title`}>
        <p class="k-label"><span class="k-n">{String(gi + 1).padStart(2, '0')}</span><span id={`${g.id}-title`}>{g.title}</span></p>
        {g.note && <p class="k-note">{g.note}</p>}
        <ul class="k-grid">
          {g.items.map((x) => (
            <li>
              <div class="k-card">
                <div class="k-card-top">
                  <a class="k-card-t" href={x.url} rel="noopener">{x.title}</a>
                  <span class:list={['k-tag', { y: x.cost === 'free' }]}>{costLabel(x.cost)}</span>
                </div>
                <p class="k-card-m">{x.issuer} &middot; {x.price}</p>
                <p class="k-card-s">{x.why}</p>
                <ul class="k-tiles k-card-f">
                  <li class="k-tiles-label">Helps for</li>
                  {x.jobs.map((j) => <li><a class="k-tile" data-family={j.family} style="--c: var(--family)" href={`/roles/${j.id}`}>{j.title}</a></li>)}
                </ul>
              </div>
            </li>
          ))}
        </ul>
      </section>
    ))
  }
</Base>

<style>
  .k-sec:first-of-type { margin-top: 48px; }
  .k-card-f.k-tiles { display: flex; }
</style>
