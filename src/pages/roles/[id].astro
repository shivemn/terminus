---
import Base from '../../layouts/Base.astro';
import RolePlanner from '../../components/RolePlanner';
import { content, jobStarts, listOf, plannerNodes } from '../../lib/site';
import { interviewLinks, jobLinks, loopFor, searchTerm, sitesFor, startupMatch } from '../../lib/jobs';
import { BACKGROUND_GROUPS, TIERS } from '../../lib/schema';
import { certificationsFor, fareText } from '../../lib/certifications';
import { midSentence } from '../../lib/text';
import '../../styles/route.css';
import '../../styles/planner.css';
import '../../styles/map.css';
import '../../styles/picks.css';

export function getStaticPaths() {
  return content().roles.map((r) => ({ params: { id: r.id } }));
}

const c = content();
const role = c.roles.find((r) => r.id === Astro.params.id)!;
const family = c.families.find((f) => f.id === role.family)!;
const counts = TIERS.map((t) => ({ ...t, n: role.tiers[t.id].length })).filter((t) => t.n > 0);

const term = searchTerm(role);
const sites = sitesFor(c.jobSites, role);
const links = jobLinks(role, sites);
const yc = startupMatch(sites, c.startups);
const loop = loopFor(c.interviews, role);
const asked = interviewLinks(role, sites);
const certs = certificationsFor(role, c.certifications);
// A job title: which route it builds on, and what it adds.
const base = role.variantOf ? c.roles.find((r) => r.id === role.variantOf) : undefined;
const titleOf = (id: string) => c.concepts.find((x) => x.id === id)?.title ?? id;
const added = base ? role.tiers.hire.filter((id) => !base.tiers.hire.includes(id)).map(titleOf) : [];
const removed = base ? base.tiers.hire.filter((id) => !role.tiers.hire.includes(id)).map(titleOf) : [];
const siblings = base ? c.roles.filter((r) => r.variantOf === base.id && r.id !== role.id) : c.roles.filter((r) => r.variantOf === role.id);
// Snapshots are dated by month: the numbers are a picture of that month, not of today.
const monthOf = (d: string) => new Date(d).toLocaleDateString('en-IN', { month: 'long', year: 'numeric' });
const allStartups = c.startups;
const startupFreshers = allStartups.experience.filter(([k]) => /new grads|Internship/.test(k)).reduce((n, [, v]) => n + v, 0);
const posting = role.posting;
const evidence = role.evidence ?? base?.evidence;
const isJob = role.kind !== 'exam';
const MONTHS = ['January', 'February', 'March', 'April', 'May', 'June', 'July', 'August', 'September', 'October', 'November', 'December'];
const monthName = (ym: string) => `${MONTHS[Number(ym.slice(5, 7)) - 1]} ${ym.slice(0, 4)}`;
// Sections are numbered like the home page.
const nRoute = '01';
const nJob = isJob ? '02' : '';
const nOpen = isJob ? '03' : '';
const nAsk = isJob ? '04' : '';
const listingsHref = `https://github.com/shivemn/terminus/blob/main/research/postings/${base && !role.evidence ? base.id : role.id}.csv`;
const SIB = 6;
---

<Base title={role.title} description={role.summary} wide>
  <header class="k-head role-head">
    <div class="k-head-id">
      <p class="k-crumbs"><a href="/roles">Roles</a> / {family.title}</p>
      <h1><span class="board">{role.title}</span></h1>
      <p class="k-lede">{role.summary}</p>
      {base && (
        <p class="route-of">
          The route is <a href={`/roles/${base.id}`}>{base.title}</a>
          {added.length > 0 ? `, with ${listOf(added)} on the hiring list` : ''}{removed.length > 0 ? ` instead of ${listOf(removed)}` : ''}.
        </p>
      )}
    </div>
    <dl class="k-glance" data-family={role.family}>
      <div><dt>Line</dt><dd><a class="k-tile" href={`/roles#${family.id}`} style="--c: var(--family)">{family.title}</a></dd></div>
      <div>
        <dt>{isJob ? 'Hiring list' : 'Syllabus'}</dt>
        <dd class="k-big"><span class="num">{role.tiers.hire.length}</span> {isJob ? 'stops' : 'topics'}</dd>
      </div>
      <div>
        <dt>{evidence ? 'Checked against' : 'Status'}</dt>
        <dd>
          {evidence ? (
            <a class="k-big" href={listingsHref}><span class="num">{evidence.postings}</span> listings <small>{monthName(evidence.collected)}</small></a>
          ) : role.kind === 'exam' ? (
            <span class="k-tag quiet">Official syllabus</span>
          ) : (
            <span class="k-tag quiet">Draft</span>
          )}
        </dd>
      </div>
      {siblings.length > 0 && (
        <div>
          <dt>{base ? 'Other titles on this route' : 'Also posted as'}</dt>
          <dd>
            <ul class="k-tiles">
              {siblings.slice(0, SIB).map((r) => <li><a class="k-tile" href={`/roles/${r.id}`} style="--c: var(--family)">{r.title}</a></li>)}
              {siblings.length > SIB && <li class="more-sib"><a href={`/roles#${family.id}`}>and {siblings.length - SIB} more</a></li>}
            </ul>
          </dd>
        </div>
      )}
    </dl>
  </header>
  {
    evidence ? (
        <p class="evidence">
          {base && !role.evidence ? (
            <>
              Its route, <a href={`/roles/${base.id}`}>{base.title}</a>, was checked against {evidence.postings}{' '}
              {evidence.region.startsWith('Global') ? "listings on companies' own job boards worldwide" : 'entry-level Naukri listings'} in {monthName(evidence.collected)}.
            </>
          ) : (
            <>
              {evidence.region.startsWith('Global')
                ? `Checked against ${evidence.postings} listings on companies' own job boards worldwide in ${monthName(evidence.collected)}.`
                : `Checked against ${evidence.postings} entry-level Naukri listings in ${monthName(evidence.collected)}.`}
              {evidence.note && ` ${evidence.note}`}
            </>
          )}{' '}
          <a href={`https://github.com/shivemn/terminus/blob/main/research/postings/${base && !role.evidence ? base.id : role.id}.csv`}>The listings</a>
        </p>
      ) : (
        <p class="evidence draft">
          {role.kind === 'exam'
            ? 'Mapped from the published syllabus as we read it.'
            : posting
              ? 'Draft. The route is our judgement, checked against real listings below.'
              : 'Draft. This route is our judgement and hasn’t been checked against real job postings yet.'}{' '}
          <a href="https://github.com/shivemn/terminus/blob/main/docs/ROLES.md">How roles get checked</a>
        </p>
      )
    }

  <section class="k-sec route-sec" aria-labelledby="route-title">
    <p class="k-label"><span class="k-n">{nRoute}</span>Your route</p>
    <h2 id="route-title" class="k-h2">From where you are to {midSentence(role.title)}.</h2>
    {isJob && <p class="k-note jump"><a href="#the-job">{posting ? 'What the job looks like, from real listings' : 'See real openings for this job'}</a> <span aria-hidden="true">&darr;</span></p>}
    <RolePlanner
      client:load
      role={{ id: role.id, title: role.title, tiers: role.tiers, projects: role.projects }}
      concepts={plannerNodes(c)}
      areas={c.areas}
      tiers={TIERS}
      backgrounds={c.backgrounds}
      backgroundGroups={BACKGROUND_GROUPS}
      jobs={jobStarts(c)}
    />
  </section>

  {
    isJob && (
      <section class="k-sec job" id="the-job" aria-labelledby="the-job-title">
        <p class="k-label"><span class="k-n">{nJob}</span>What the job looks like</p>
        <h2 id="the-job-title" class="k-h2">{posting ? `From ${posting.listings} real listings.` : 'What the listings say.'}</h2>
        {posting ? (
          <>
            <p class="k-note job-source">
              Summarised in our own words from {posting.listings} {evidence?.region.startsWith('Global') ? '' : 'entry-level '}listings on {posting.source}, {monthName(posting.collected)}.
              {' '}{posting.method}
            </p>
            <div class="k-two">
              <div class="k-box">
                <h3 class="k-box-t">What you'd do</h3>
                <ol class="job-doing">{posting.doing.map((d, i) => <li><b class="num">{String(i + 1).padStart(2, '0')}</b><span>{d}</span></li>)}</ol>
                <h3>Titles you'll see</h3>
                <p>{posting.titles.join(', ')}.</p>
                <h3>Experience asked for</h3>
                <p>{posting.experience}</p>
              </div>
              <div class="k-box y">
                <h3 class="k-box-t">What the listings ask for</h3>
                <p class="quiet small">Out of the {posting.tagged} listings that named skills. Listings show only a few tags, so the real numbers are higher.</p>
                <ul class="asks">
                  {posting.asks.map((a) => (
                    <li>
                      <span class="ask-name">{a.skill}</span>
                      <span class="ask-bar" aria-hidden="true"><span style={`width:${Math.round((a.listings / posting.tagged) * 100)}%`} /></span>
                      <span class="ask-n">{a.listings} of {posting.tagged}</span>
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          </>
        ) : (
          <p class="k-note">We haven't summarised real listings for this role yet. The searches below show what's open today.</p>
        )}
      </section>
    )
  }

  {
    isJob && (
      <section class="k-sec" id="openings" aria-labelledby="openings-title">
        <p class="k-label"><span class="k-n">{nOpen}</span>See real openings</p>
        <h2 id="openings-title" class="k-h2">What's open today.</h2>
        <div class="openings">
          <div class="site-groups">
            {links.map((g) => (
              <div class="k-box site-group">
                <h4>{g.title}</h4>
                <p class="boards">
                  {g.links.map((b) => (
                    <a class="k-tile board-link" href={b.url} rel="noopener" target="_blank">{b.name}{b.note && <span class="quiet"> ({b.note})</span>}</a>
                  ))}
                </p>
              </div>
            ))}
          </div>
          {yc && (
            <div class="k-box yc-note">
              <h4>At startups</h4>
              <p>
                In {monthOf(yc.collected)}, startups funded by Y Combinator and based in India had {yc.n}{' '}
                {listOf(yc.kinds.map((k) => (/^[A-Z]{2}/.test(k) ? k : k.toLowerCase())))} {yc.n === 1 ? 'opening' : 'openings'} across {yc.companies}{' '}
                {yc.companies === 1 ? 'company' : 'companies'}, and {yc.newGrad === 0 ? 'none' : yc.newGrad} took new graduates or interns.
                {yc.top.length > 0 && ` The skills they named most: ${yc.top.join(', ')}.`}
              </p>
              <p class="quiet small">
                Across every kind of job, {startupFreshers} of {allStartups.counted} startup openings took new graduates, so a startup
                is more often a second job than a first. The startup links above show what's open today.
              </p>
            </div>
          )}
          <p class="quiet small">Searches for “{term.replace(/\s+fresher$/i, '')}”. Read a few listings end to end: the skills repeat quickly.</p>
          {role.reference && (
            <p class="small">Official description: <a href={role.reference.url} rel="noopener">{role.reference.title}</a></p>
          )}
        </div>
      </section>
    )
  }

  {
    isJob && (
      <section class="k-sec" id="interviews" aria-labelledby="interviews-title">
        <p class="k-label"><span class="k-n">{nAsk}</span>Interviews and certificates</p>
        <h2 id="interviews-title" class="k-h2">What they'll ask, and what helps.</h2>
        <div class="k-two">
          <div class="k-box interview-note">
            <h4>Interviews</h4>
            <p>
              {loop ? (
                <>
                  Usually {loop.rounds.length} rounds: {loop.rounds.map((r) => r.name.charAt(0).toLowerCase() + r.name.slice(1)).join(', then ')}.{' '}
                  <a href={`/practice#interview-${loop.id}`}>What each round tests and where to practise it</a>{' '}
                  <span class="quiet">({loop.title})</span>.
                </>
              ) : (
                <>See <a href="/practice#interviews">how interviews go</a> for each kind of job, and where to practise.</>
              )}
            </p>
            <p class="small">
              Questions people were asked for this job:{' '}
              {asked.map((x, i) => <>{i > 0 && ', '}<a href={x.url} rel="noopener" target="_blank">{x.name}</a></>)}.
            </p>
          </div>
          {certs.length > 0 && (
            <div class="k-box interview-note cert-note">
              <h4>Certificates worth having</h4>
              <ul>
                {certs.map((x) => (
                  <li>
                    <a href={x.url} rel="noopener">{x.title}</a>{' '}
                    <span class="quiet small">{fareText(x)}</span>
                  </li>
                ))}
              </ul>
              <p class="small">None of these replaces showing your work. <a href="/certifications">All certifications, and why each one counts</a>.</p>
            </div>
          )}
        </div>
      </section>
    )
  }

  <noscript>
    <section class="static-list">
      {counts.map((t) => (
        <>
          <h2>{t.title}</h2>
          <ul>{role.tiers[t.id].map((id) => <li><a href={`/concepts/${id}`}>{c.concepts.find((x) => x.id === id)!.title}</a></li>)}</ul>
        </>
      ))}
    </section>
  </noscript>
</Base>

<style>
  /* The job's name carries over from the link you came from into this board. */
  .role-head h1 .board { view-transition-name: role-board; }
  .route-of { font-weight: 600; }
  .more-sib { align-self: center; font-size: 0.85rem; }
  .evidence { margin-top: 26px; max-width: 90ch; font-size: 0.95rem; color: var(--ink-2); padding: 10px 14px; border: 2px solid var(--ink); border-left: 8px solid var(--programming); background: var(--paper); }
  .evidence.draft { border-left-color: var(--warn); }
  .static-list { margin-top: 24px; }
  .jump { font-weight: 600; margin-bottom: 18px; }
  .route-sec :global(.planner) { margin-top: 0; }
  .small { font-size: 0.92rem; }

  .job-source { max-width: 76ch; }
  .k-box h3 { margin: 0 0 10px; }
  .k-box h3 ~ h3 { margin-top: 22px; font-size: 1.25rem; }
  .job-doing { list-style: none; padding: 0; margin: 0; display: grid; gap: 12px; }
  .job-doing li { display: grid; grid-template-columns: 36px minmax(0, 1fr); gap: 10px; align-items: start; }
  .job-doing b { font-family: var(--sign); font-weight: 720; font-size: 1.7rem; line-height: 0.85; color: var(--ink-3); }
  .asks { list-style: none; padding: 0; margin: 10px 0 0; display: grid; gap: 10px; }
  .asks li { display: grid; grid-template-columns: 1fr auto; gap: 4px 12px; align-items: baseline; }
  .ask-bar { grid-column: 1 / -1; grid-row: 2; height: 12px; background: var(--paper); border: 1.5px solid var(--ink); }
  .ask-bar span { display: block; height: 100%; background: var(--yellow); border-right: 1.5px solid var(--ink); transform-origin: left; }
  .motion .asks .ask-bar span { animation: grow 0.9s cubic-bezier(0.2, 0.7, 0.2, 1) both; }
  @keyframes grow { from { transform: scaleX(0); } }
  .ask-n { font-family: var(--sign); font-weight: 720; font-size: 1.15rem; font-variant-numeric: tabular-nums; white-space: nowrap; }

  .openings { margin-top: 20px; }
  .site-groups { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr)); gap: 16px; margin: 0 0 16px; }
  .site-group h4, .interview-note h4, .yc-note h4 { font-family: var(--sign); font-stretch: 88%; font-weight: 700; font-size: 1.35rem; line-height: 1.05; margin: 0 0 10px; }
  .boards { display: flex; flex-wrap: wrap; gap: 8px; margin: 0; }
  .board-link { --c: var(--yellow); }
  .yc-note { margin: 0 0 16px; max-width: 90ch; }
  .interview-note p { margin: 0; }
  .interview-note p + p, .yc-note p + p { margin-top: 8px; }
  .yc-note p { margin: 0; }
  .cert-note ul { margin: 0 0 8px; padding-left: 1.2em; }
  .cert-note li { margin-bottom: 4px; }
</style>
