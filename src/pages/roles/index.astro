---
import Base from '../../layouts/Base.astro';
import { content } from '../../lib/site';

const c = content();
const routes = c.roles.filter((r) => !r.variantOf);
const titlesOf = (id: string) => c.roles.filter((r) => r.variantOf === id).sort((a, b) => a.title.localeCompare(b.title));
const groups = c.families
  .map((f) => ({ family: f, routes: routes.filter((r) => r.family === f.id) }))
  .filter((g) => g.routes.length > 0);
const jobCount = c.roles.filter((r) => r.kind !== 'exam').length;
const examCount = c.roles.length - jobCount;
const jobRoutes = routes.filter((r) => r.kind !== 'exam');
const checked = jobRoutes.filter((r) => r.evidence).length;
const titleCount = (f: string) => c.roles.filter((r) => r.family === f).length;
const SHOWN = 5;
---

<Base title="Roles" description="Pick a job and see what it takes to get hired, starting from what you already know." wide>
  <header class="k-head">
    <div class="k-head-id">
      <h1><span class="board">All roles</span></h1>
      <p class="k-lede">
        Titles that need the same skills share a route: a Java developer and a Spring Boot developer are both on the backend
        route, with a little extra each. Every route is a draft until it has been checked against real job postings.
      </p>
    </div>
    <dl class="k-glance">
      <div><dt>Job titles</dt><dd class="k-big num">{jobCount}</dd></div>
      <div><dt>Routes</dt><dd class="k-big"><span class="num">{jobRoutes.length}</span> <small>{checked} checked against listings</small></dd></div>
      <div><dt>Exams</dt><dd class="k-big num">{examCount}</dd></div>
    </dl>
  </header>

  <div class="find">
    <label class="find-box">
      <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="M20 20l-4-4" /></svg>
      <span class="visually-hidden">Find a job</span>
      <input id="role-filter" type="search" placeholder="Find a job, like java, analyst, sap or security" autocomplete="off" data-filter />
    </label>
    <span class="quiet small" data-count aria-live="polite"></span>
  </div>
  <nav class="k-chips" aria-label="Families of jobs">
    {groups.map(({ family }) => (
      <a class="k-chip" href={`#${family.id}`} data-family={family.id} style="--c: var(--family)"><i></i>{family.short ?? family.title} <b>{titleCount(family.id)}</b></a>
    ))}
  </nav>

  {
    groups.map(({ family, routes }, gi) => (
      <section class="k-sec" id={family.id} data-family={family.id} aria-labelledby={`${family.id}-title`} data-group>
        <p class="k-label"><span class="k-n">{String(gi + 1).padStart(2, '0')}</span>{family.title}</p>
        <h2 id={`${family.id}-title`} class="k-h2">
          {routes.length} {routes.length === 1 ? 'route' : 'routes'}, {titleCount(family.id)} {family.id === 'exams' ? 'exams' : 'job titles'}.
        </h2>
        <ul class="k-grid">
          {routes.map((r) => {
            const titles = titlesOf(r.id);
            return (
              <li data-route data-text={[r.title, r.summary, ...titles.map((t) => t.title)].join(' ').toLowerCase()}>
                <div class="k-card" style="--c: var(--family)">
                  <a class="k-card-t" href={`/roles/${r.id}`}>{r.title}</a>
                  <p class="k-card-s">{r.summary}</p>
                  {titles.length > 0 && (
                    <ul class="k-tiles" data-titles>
                      <li class="k-tiles-label">Also posted as</li>
                      {titles.map((t, i) => (
                        <li data-extra={i >= SHOWN ? '' : undefined} hidden={i >= SHOWN}>
                          <a class="k-tile" href={`/roles/${t.id}`} data-title={t.title.toLowerCase()} style="--c: var(--family)">{t.title}</a>
                        </li>
                      ))}
                      {titles.length > SHOWN && (
                        <li><button type="button" class="k-tile more" data-more>+{titles.length - SHOWN} more</button></li>
                      )}
                    </ul>
                  )}
                  <p class="k-card-f">
                    {r.kind === 'exam' ? (
                      <span class="k-tag quiet">Official syllabus</span>
                    ) : r.evidence ? (
                      <span class="k-tag y">Checked against {r.evidence.postings} listings</span>
                    ) : (
                      <span class="k-tag quiet">Draft</span>
                    )}
                    <span>
                      {r.tiers.hire.length} {r.kind === 'exam' ? 'syllabus topics' : 'stops on the hiring list'}
                      {r.posting && '. Real listings summarised'}
                    </span>
                  </p>
                </div>
              </li>
            );
          })}
        </ul>
      </section>
    ))
  }
  <p class="none" data-none hidden>
    No job matches that. Try a shorter word, or <a href="/tools">look for a tool</a> instead.
  </p>
</Base>

<script>
  const input = document.querySelector<HTMLInputElement>('[data-filter]');
  if (input) {
    const count = document.querySelector<HTMLElement>('[data-count]')!;
    const none = document.querySelector<HTMLElement>('[data-none]')!;
    const routes = [...document.querySelectorAll<HTMLElement>('[data-route]')];
    const groups = [...document.querySelectorAll<HTMLElement>('[data-group]')];
    const apply = () => {
      const words = input.value.toLowerCase().split(/\s+/).filter(Boolean);
      let shown = 0;
      for (const li of routes) {
        const show = words.every((w) => li.dataset.text!.includes(w));
        li.hidden = !show;
        if (show) shown++;
        // Point out the titles that match, so "java" lights up Java developer.
        for (const chip of li.querySelectorAll<HTMLElement>('[data-title]')) {
          const hit = words.length > 0 && words.every((w) => chip.dataset.title!.includes(w));
          chip.classList.toggle('hit', hit);
          // A folded-away title that matches comes out of hiding.
          const item = chip.parentElement!;
          if ('extra' in item.dataset && hit) item.hidden = false;
        }
      }
      for (const g of groups) g.hidden = !g.querySelector('[data-route]:not([hidden])');
      none.hidden = shown > 0;
      count.textContent = words.length ? `${shown} ${shown === 1 ? 'route' : 'routes'} match` : '';
    };
    input.addEventListener('input', apply);

    // "+N more" opens the rest of a route's titles.
    for (const btn of document.querySelectorAll<HTMLButtonElement>('[data-more]')) {
      btn.addEventListener('click', () => {
        const list = btn.closest('[data-titles]')!;
        list.querySelectorAll<HTMLElement>('[data-extra]').forEach((li) => (li.hidden = false));
        btn.parentElement!.remove();
      });
    }
  }
</script>

<style>
  .small { font-size: 0.92rem; }
  .visually-hidden { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  .find { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 14px; margin-top: 40px; }
  .find-box {
    flex: 1 1 320px; max-width: 640px; display: flex; align-items: center; gap: 10px; min-height: 50px; padding: 0 14px;
    border: 2px solid var(--ink); background: var(--paper);
  }
  .find-box:focus-within { outline: 3px solid var(--focus); outline-offset: 2px; }
  .find-box svg { width: 18px; height: 18px; flex: none; fill: none; stroke: currentColor; stroke-width: 2.4; stroke-linecap: round; }
  .find-box input { flex: 1; min-width: 0; height: 46px; border: 0; background: none; font: inherit; font-size: 1.02rem; color: var(--ink); outline: none; }
  .k-chips { margin-top: 12px; }
  .k-grid { grid-template-columns: repeat(auto-fill, minmax(min(100%, 360px), 1fr)); }
  .k-tile.more { cursor: pointer; font: inherit; font-family: var(--sign); font-stretch: 88%; font-weight: 650; font-size: 1.02rem; }
  .k-tile.more::before { background: var(--yellow); }
  .k-tile.more:hover { background: var(--platform); padding-left: 18px; }
  .k-tiles { margin-top: 2px; }
  .none { margin-top: 32px; font-size: 1.1rem; }
</style>
