---
import Base from '../../layouts/Base.astro';
import DesignDiagram from '../../components/DesignDiagram.astro';
import { content } from '../../lib/site';
import { LEVELS } from '../../lib/designs';

export function getStaticPaths() {
  return content().designs.map((d) => ({ params: { id: d.id } }));
}

const c = content();
const d = c.designs.find((x) => x.id === Astro.params.id)!;
const level = LEVELS.find((l) => l.id === d.level)!;
const shelved = new Set(c.toolGroups.flatMap((g) => g.tools));
const href = (id: string) => `/${shelved.has(id) ? 'tools' : 'concepts'}/${id}`;
const stopIds = new Set([...d.stops, ...d.diagram.nodes.flatMap((n) => (n.stop ? [n.stop] : []))]);
const hrefs = Object.fromEntries([...stopIds].map((id) => [id, href(id)]));
const stops = d.stops.map((id) => c.concepts.find((x) => x.id === id)!);
// Up to eight related designs: most shared stops first, same group as a tie-break.
const mine = new Set(d.stops);
const others = c.designs
  .filter((x) => x.id !== d.id)
  .map((x) => ({ x, score: x.stops.filter((s) => mine.has(s)).length * 2 + (x.group === d.group ? 1 : 0) }))
  .sort((a, b) => b.score - a.score)
  .slice(0, 8)
  .map((o) => o.x);
const firstSentence = d.summary.split(/(?<=\.)\s/)[0];
let k = 0;
const num = () => String(++k).padStart(2, '0');
---

<Base wide title={d.title} description={firstSentence}>
  <article class="design" data-area="systems">
    <header class="k-head">
      <div class="k-head-id">
        <p class="k-crumbs"><a href="/designs">Designs</a> / {level.title}</p>
        <h1><span class="board">{d.title}</span></h1>
        <p class="k-lede">{d.summary}</p>
      </div>
      <dl class="k-glance">
        <div><dt>Like</dt><dd class="k-big">{d.like.join(', ')}</dd></div>
        <div><dt>Level</dt><dd><span class="k-tag y">{level.title}</span></dd></div>
        <div><dt>To follow</dt><dd class="k-big"><span class="num">{d.flows.length}</span> flows <small>through the diagram</small></dd></div>
        <div><dt>Compared with</dt><dd class="k-big"><a href="#real-h"><span class="num">{d.companies.length}</span> {d.companies.length === 1 ? 'company' : 'companies'} <span aria-hidden="true">&darr;</span></a></dd></div>
        <div><dt>Stops to learn</dt><dd class="k-big"><a href="#learn"><span class="num">{stops.length}</span> stops <span aria-hidden="true">&darr;</span></a></dd></div>
      </dl>
    </header>

    <section class="k-sec diagram-block" aria-labelledby="arch">
      <p class="k-label"><span class="k-n">{num()}</span>How it fits together</p>
      <h2 id="arch" class="k-h2">Follow a request through it.</h2>
      <DesignDiagram design={d} hrefs={hrefs} />
    </section>

    <section class="k-sec" aria-labelledby="reqs">
      <p class="k-label"><span class="k-n">{num()}</span>What it must do</p>
      <h2 id="reqs" class="k-h2">Features, and how well it has to do them.</h2>
      <div class="k-two">
        <div class="k-box">
          <h3 class="k-box-t">Features</h3>
          <ul class="ticks">{d.requirements.features.map((x) => <li>{x}</li>)}</ul>
        </div>
        <div class="k-box">
          <h3 class="k-box-t">Qualities</h3>
          <ul class="ticks">{d.requirements.qualities.map((x) => <li>{x}</li>)}</ul>
        </div>
      </div>
    </section>

    <section class="k-sec" aria-labelledby="nums">
      <p class="k-label"><span class="k-n">{num()}</span>Rough numbers</p>
      <h2 id="nums" class="k-h2">How big it gets.</h2>
      <p class="k-note">{d.numbers.assumption}</p>
      <div class="k-box y numbers">
        <div class="table-wrap">
          <table>
            <thead><tr><th scope="col">What</th><th scope="col">Size</th><th scope="col">How we got it</th></tr></thead>
            <tbody>
              {d.numbers.rows.map((r) => (
                <tr><td>{r.what}</td><td class="num">{r.size}</td><td>{r.how}</td></tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
      {d.numbers.realScale.length > 0 && (
        <div class="k-box real">
          <h3 class="k-box-t">At real scale</h3>
          {d.numbers.realScale.map((r) => (
            <p>
              <b>{r.name}</b> {r.text}{' '}
              <a href={r.source.url} rel="noopener">({r.source.publisher}, {r.source.year})</a>
            </p>
          ))}
        </div>
      )}
    </section>

    <section class="k-sec" aria-labelledby="dec">
      <p class="k-label"><span class="k-n">{num()}</span>Key decisions</p>
      <h2 id="dec" class="k-h2">The choices that shape it.</h2>
      <ol class="k-grid decide">
        {d.decisions.map((x, i) => (
          <li>
            <div class="k-card">
              <span class="dec-n num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
              <h3 class="k-card-t">{x.title}</h3>
              <p class="k-card-s">{x.text}</p>
            </div>
          </li>
        ))}
      </ol>
    </section>

    <section class="k-sec" aria-labelledby="brk">
      <p class="k-label"><span class="k-n">{num()}</span>What breaks first</p>
      <h2 id="brk" class="k-h2">Where it strains, and the fix.</h2>
      <ul class="k-grid breaks">
        {d.breaks.map((b) => (
          <li>
            <div class="k-card" style="--c: var(--warn)">
              <h3 class="k-card-t">{b.what}</h3>
              <p class="k-card-s">{b.fix}</p>
            </div>
          </li>
        ))}
      </ul>
    </section>

    <section class="k-sec" id="real" aria-labelledby="real-h">
      <p class="k-label"><span class="k-n">{num()}</span>How the real ones built it</p>
      <h2 id="real-h" class="k-h2">What each company has published about its own system.</h2>
      <ul class="k-grid">
        {d.companies.map((co) => (
          <li>
            <div class="k-card co">
              <h3 class="k-card-t">{co.name}</h3>
              <p class="k-card-s">{co.text}</p>
              <ul class="k-card-f co-links">
                {co.links.map((l) => (
                  <li><a href={l.url} rel="noopener">{l.title}</a> <small>{l.publisher}, {l.year}</small></li>
                ))}
              </ul>
            </div>
          </li>
        ))}
      </ul>
      {d.others.length > 0 && (
        <div class="k-box others">
          <h3 class="k-box-t">Other diagrams worth seeing</h3>
          <ul class="ticks">
            {d.others.map((o) => (
              <li><a href={o.url} rel="noopener">{o.title}</a> <small class="quiet">{o.publisher}{o.licence ? `, ${o.licence}` : ''}</small></li>
            ))}
          </ul>
        </div>
      )}
    </section>

    <section class="k-sec" id="learn" aria-labelledby="learn-h">
      <p class="k-label"><span class="k-n">{num()}</span>Learn the pieces</p>
      <h2 id="learn-h" class="k-h2">Each of these is a stop on Terminus routes.</h2>
      <ul class="k-tiles pieces">
        {stops.map((s) => <li><a class="k-tile" data-area={s.area} style="--c: var(--line)" href={href(s.id)}>{s.title}</a></li>)}
      </ul>
    </section>

    <section class="k-sec more" aria-labelledby="more">
      <p class="k-label"><span class="k-n">{num()}</span>Related designs</p>
      <ul class="k-tiles pieces">
        {others.map((o) => <li><a class="k-tile" href={`/designs/${o.id}`}>{o.title}</a></li>)}
        <li><a class="k-tile all" href="/designs">All {c.designs.length} designs</a></li>
      </ul>
      <p class="quiet small">
        Diagrams drawn for Terminus, simplified for learning, with icons from Tabler Icons (MIT). What a company built comes only from
        that company's own posts, talks or docs, linked above. Numbers in the table are our assumptions; real figures name their source.
      </p>
    </section>
  </article>
</Base>

<style>
  .design { padding-bottom: 40px; }
  .ticks { list-style: none; padding: 0; margin: 6px 0 0; }
  .ticks li { padding-left: 20px; position: relative; margin: 6px 0; }
  .ticks li::before { content: ''; position: absolute; left: 2px; top: 0.62em; width: 8px; height: 8px; background: var(--yellow); outline: 1.5px solid var(--ink); }
  .numbers { margin-top: 16px; padding: 10px 20px 14px; }
  .table-wrap { overflow-x: auto; }
  table { border-collapse: collapse; width: 100%; font-size: 0.98rem; }
  th, td { text-align: left; vertical-align: top; padding: 10px 12px 10px 0; border-bottom: 1px solid var(--rule); }
  thead th { border-bottom: 3px solid var(--ink); font-family: var(--sign); font-stretch: 88%; font-weight: 700; font-size: 1.15rem; }
  td.num { font-family: var(--sign); font-weight: 720; font-size: 1.2rem; white-space: nowrap; }
  .real { margin-top: 20px; }
  .real p { margin: 8px 0 0; font-size: 0.98rem; }
  .real a { color: var(--ink-2); }
  .decide { list-style: none; }
  .dec-n { font-family: var(--sign); font-weight: 720; font-size: 2.2rem; line-height: 0.8; color: var(--ink-3); }
  .k-card:hover .dec-n { color: var(--ink); }
  .co-links { list-style: none; margin: 0; padding: 12px 0 0; display: grid; gap: 6px; }
  .co-links li { font-size: 0.92rem; }
  .co-links a { font-weight: 600; }
  .co-links small, .others small { color: var(--ink-3); font-size: 0.85rem; }
  .others { margin-top: 20px; }
  .pieces { margin-top: 18px; gap: 8px; }
  .pieces .k-tile { min-height: 40px; font-size: 1.15rem; }
  .k-tile.all { --c: var(--yellow); }
  .small { font-size: 0.9rem; max-width: 80ch; margin-top: 18px; }
</style>
