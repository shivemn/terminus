---
import Base from '../../layouts/Base.astro';
import { content } from '../../lib/site';
import { LEVELS } from '../../lib/designs';

const c = content();
const apps = c.designs.filter((d) => d.group === 'app');
const blocks = c.designs.filter((d) => d.group === 'block');
const groups = LEVELS.map((l) => ({ ...l, items: apps.filter((d) => d.level === l.id) })).filter((g) => g.items.length);
const order = Object.fromEntries(LEVELS.map((l, i) => [l.id, i]));
const blockItems = [...blocks].sort((a, b) => order[a.level] - order[b.level]);
const levelTitle = Object.fromEntries(LEVELS.map((l) => [l.id, l.title]));
const sections = [
  ...groups.map((g) => ({ id: `level-${g.id}`, title: g.title, note: g.note, items: g.items, block: false })),
  ...(blockItems.length ? [{ id: 'blocks', title: 'Building blocks', note: 'The infrastructure the apps above are built on, each marked with its level.', items: blockItems, block: true }] : []),
];
const first = (t: string) => t.split(/(?<=\.)\s/)[0];
---

<Base
  wide
  title="Designs"
  description={`${c.designs.length} worked system designs: apps you use, from chat and UPI payments to video calls and food delivery, and the building blocks under them, from message queues to caches and crawlers.`}
>
  <header class="k-head">
    <div class="k-head-id">
      <h1><span class="board">Designs</span></h1>
      <p class="k-lede">
        System designs for products you already use. Each one starts with a diagram you can follow request by request, then
        the numbers, the key decisions and what breaks first, and links to what the real companies published about their own
        systems.
      </p>
    </div>
    <dl class="k-glance">
      <div><dt>Designs</dt><dd class="k-big num">{c.designs.length}</dd></div>
      <div><dt>Levels</dt><dd class="k-tiles">{LEVELS.map((l) => <span class="k-tag">{l.title}</span>)}</dd></div>
      <div><dt>A note</dt><dd class="k-card-m">These are our designs, written for learning and simplified. What a company actually built comes only from its own posts, talks or docs, linked on each page.</dd></div>
    </dl>
  </header>

  <nav class="k-chips" aria-label="Levels">
    {sections.map((g) => <a class="k-chip" href={`#${g.id}`}><i></i>{g.title} <b>{g.items.length}</b></a>)}
  </nav>

  {
    sections.map((g, gi) => (
      <section class="k-sec" id={g.id} aria-labelledby={`${g.id}-title`}>
        <p class="k-label"><span class="k-n">{String(gi + 1).padStart(2, '0')}</span><span id={`${g.id}-title`}>{g.title}</span></p>
        <p class="k-note">{g.note}</p>
        <ul class="k-grid">
          {g.items.map((d) => (
            <li>
              <div class="k-card">
                <a class="k-card-t" href={`/designs/${d.id}`}>{d.title}</a>
                <p class="k-card-m">Like {d.like.join(', ')}</p>
                <p class="k-card-s">{first(d.summary)}</p>
                <p class="k-card-f">
                  <span class="k-tag">{levelTitle[d.level]}</span>
                  <span>{d.flows.length} flows to follow, {d.companies.length} {d.companies.length === 1 ? 'company' : 'companies'} compared</span>
                </p>
              </div>
            </li>
          ))}
        </ul>
      </section>
    ))
  }
</Base>

<style>
  .k-sec:first-of-type { margin-top: 48px; }
  .k-glance .k-tiles { display: flex; flex-wrap: wrap; gap: 6px; }
</style>
