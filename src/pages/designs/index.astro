---
import Base from '../../layouts/Base.astro';
import { content } from '../../lib/site';
import { LEVELS } from '../../lib/designs';

const c = content();
const apps = c.designs.filter((d) => d.group === 'app');
const blocks = c.designs.filter((d) => d.group === 'block');
const groups = LEVELS.map((l) => ({ ...l, items: apps.filter((d) => d.level === l.id) })).filter((g) => g.items.length);
const order = Object.fromEntries(LEVELS.map((l, i) => [l.id, i]));
const blockItems = [...blocks].sort((a, b) => order[a.level] - order[b.level]);
const levelTitle = Object.fromEntries(LEVELS.map((l) => [l.id, l.title]));
---

<Base
  wide
  title="Designs"
  description={`${c.designs.length} worked system designs: apps you use, from chat and UPI payments to video calls and food delivery, and the building blocks under them, from message queues to caches and crawlers.`}
>
  <h1><span class="board">Designs</span></h1>
  <p class="lede">
    System designs for products you already use. Each one starts with a diagram you can follow request by request, then
    the numbers, the key decisions and what breaks first, and links to what the real companies published about their own
    systems.
  </p>
  <p class="quiet note">
    These are our designs, written for learning. They're simplified, and the real systems differ. What a company actually
    built comes only from that company's own posts, talks or docs, linked on each page.
  </p>

  {
    groups.map((g) => (
      <section aria-labelledby={`level-${g.id}`}>
        <h2 id={`level-${g.id}`}>{g.title}</h2>
        <p class="quiet level-note">{g.note}</p>
        <ul class="designs">
          {g.items.map((d) => (
            <li>
              <a class="design-name" href={`/designs/${d.id}`}>{d.title}</a>
              <p class="like">Like {d.like.join(", ")}</p>
              <p class="quiet">{d.summary.split(/(?<=\.)\s/)[0]}</p>
              <p class="faint meta">{d.flows.length} flows to follow, {d.companies.length} {d.companies.length === 1 ? "company" : "companies"} compared</p>
            </li>
          ))}
        </ul>
      </section>
    ))
  }

  {
    blockItems.length > 0 && (
      <section aria-labelledby="blocks">
        <h2 id="blocks">Building blocks</h2>
        <p class="quiet level-note">The infrastructure the apps above are built on, each marked with its level.</p>
        <ul class="designs">
          {blockItems.map((d) => (
            <li>
              <a class="design-name" href={`/designs/${d.id}`}>{d.title}</a>
              <p class="like">Like {d.like.join(", ")} <span class="chip-level">{levelTitle[d.level]}</span></p>
              <p class="quiet">{d.summary.split(/(?<=\.)\s/)[0]}</p>
              <p class="faint meta">{d.flows.length} flows to follow, {d.companies.length} {d.companies.length === 1 ? "company" : "companies"} compared</p>
            </li>
          ))}
        </ul>
      </section>
    )
  }
</Base>

<style>
  h1 { padding-top: 8px; font-size: clamp(2.2rem, 7vw, 3.6rem); }
  .lede { font-size: 1.1875rem; max-width: 66ch; margin-top: 14px; }
  .note { max-width: 66ch; margin-top: 8px; }
  section { margin-top: 40px; }
  .level-note { margin-top: 2px; }
  .designs {
    list-style: none; padding: 0; margin: 12px 0 0; border-top: 3px solid var(--ink);
    display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); column-gap: 32px;
  }
  .designs li { padding: 14px 0 18px; border-bottom: 1px solid var(--rule); display: grid; gap: 4px; align-content: start; }
  .design-name { font-family: var(--sign); font-stretch: 85%; font-size: 1.5rem; font-weight: 650; line-height: 1.1; }
  .like { font-weight: 600; font-size: 0.97rem; }
  .meta { font-size: 0.9rem; }
  .chip-level { display: inline-block; font: 700 0.8rem var(--text); border: 2px solid var(--ink); padding: 0 6px; margin-left: 6px; vertical-align: 1px; }
  @media (max-width: 560px) { .designs { grid-template-columns: 1fr; } }
</style>
