---
import Base from '../layouts/Base.astro';
import LinesExplorer from '../components/LinesExplorer.astro';
import HeroRide from '../components/HeroRide.astro';
import { planPath, withPrerequisites } from '../lib/graph';
import { duration } from '../lib/coaches';
import { BACKGROUND_GROUPS } from '../lib/schema';
import { content, listOf, plannerNodes } from '../lib/site';
import { stopDetails } from '../lib/stops';
import { midSentence } from '../lib/text';
import '../styles/picker.css';
import '../styles/route.css';

const c = content();
const jobs = c.roles.filter((r) => r.kind !== 'exam');
const exams = c.roles.filter((r) => r.kind === 'exam');
// Nothing is picked to start with. The preview plans in the browser as the
// ticket changes; everything it needs is inlined below as JSON.
const previewData = {
  nodes: plannerNodes(c),
  areas: Object.fromEntries(c.areas.map((a) => [a.id, a.title])),
  backgrounds: Object.fromEntries([
    ...c.backgrounds.map((b) => [b.id, { phrase: b.phrase, knows: b.knows }]),
    // Switching jobs: everything up to that job's first year is behind you.
    ...jobs.map((r) => [`role:${r.id}`, { job: r.title, knows: [...withPrerequisites(c.concepts, [...r.tiers.hire, ...r.tiers.firstYear])] }]),
  ]),
  roles: Object.fromEntries(c.roles.map((r) => [r.id, { title: r.title, hire: r.tiers.hire }])),
};

const toolCount = c.toolGroups.reduce((n, g) => n + g.tools.length, 0);
// Every job title in the ticket, A to Z within each family; routes only in the phone list.
const groups = c.families
  .map((f) => ({ family: f, roles: c.roles.filter((r) => r.family === f.id).sort((a, b) => a.title.localeCompare(b.title)) }))
  .filter((g) => g.roles.length > 0);
const routes = c.roles.filter((r) => !r.variantOf);
const jobRoutes = routes.filter((r) => r.kind !== 'exam');
const lineCount = new Set(jobRoutes.map((r) => r.family)).size;
const WORDS = ['no', 'one', 'two', 'three', 'four', 'five', 'six', 'seven', 'eight', 'nine', 'ten'];
const lineWord = WORDS[lineCount] ?? String(lineCount);
const counts = {
  concepts: c.concepts.filter((x) => x.kind === 'concept').length,
  tools: c.concepts.filter((x) => x.kind === 'tool').length,
  projects: c.concepts.filter((x) => x.kind === 'project').length,
  resources: c.resources.filter((r) => r.free).length,
};

// "How the route is worked out", told with one real example from the planner.
const EX = { from: 'maths-grad', to: 'data-scientist' };
const exRole = c.roles.find((r) => r.id === EX.to)!;
const exBg = c.backgrounds.find((b) => b.id === EX.from)!;
const exFull = planPath(c.concepts, exRole.tiers.hire, new Set());
const exMine = planPath(c.concepts, exRole.tiers.hire, new Set(exBg.knows));
const exOrder = new Map(exMine.steps.map((s, i) => [s.id, i]));
const exAlpha = [...exFull.steps].sort((a, b) => a.title.localeCompare(b.title));
const explain = {
  title: `${exBg.title} to ${exRole.title}`,
  role: exRole.title,
  rows: exAlpha.map((s, i) => ({ title: s.title, hours: s.hours, a: i, o: exOrder.get(s.id) ?? -1 })),
  total: exFull.steps.length,
  left: exMine.steps.length,
  skipped: exFull.steps.length - exMine.steps.length,
  time: duration(exMine.totalHours, 10),
};

// "Every stop tells you exactly what to do": one real stop on the same route.
const details = stopDetails(c);
const STOP = 'pandas';
const sd = details.find((d) => d.id === STOP)!;
const project = details.find((d) => d.id === exRole.tiers.hire.find((id) => details.find((x) => x.id === id)?.kind === 'project'))!;
const sameFamily = routes.filter((r) => r.family === exRole.family && r.kind !== 'exam');
const famTitle = c.families.find((f) => f.id === exRole.family)!;
const after = sd.unlocks.filter((id) => !id.startsWith('project-')).map((id) => details.find((d) => d.id === id)!.title);
const pick = (m: 'read' | 'watch' | 'practice', kind: string, cta: string) => {
  const p = sd.picks[m]!;
  return { kind, title: p.title, meta: `${p.author} \u00b7 ${p.locator}${p.note && m === 'practice' ? `. ${p.note}` : ''}`, href: p.url, cta, build: false };
};
const stop = {
  id: sd.id,
  title: sd.title,
  summary: sd.summary,
  hours: sd.hours,
  n: exMine.steps.findIndex((s) => s.id === STOP) + 1,
  of: exMine.steps.length,
  route: `${exBg.title} to ${exRole.title}`,
  after: listOf(sd.requires.map((id) => details.find((d) => d.id === id)!.title)),
  why: `It's on the hiring list for ${midSentence(exRole.title)}, and for ${sameFamily.filter((r) => r.tiers.hire.includes(STOP)).length} of the ${sameFamily.length} ${famTitle.short ?? famTitle.title} routes. It comes before ${listOf(after.slice(0, 3).map(midSentence))}.`,
  tiles: [
    pick('read', 'Read', 'Open the book'),
    pick('watch', 'Watch', 'Start watching'),
    pick('practice', 'Practise', 'Start practising'),
    { kind: 'Build', title: project.title.replace(/^Project: (.)/, (_, x: string) => x.toUpperCase()), meta: `About ${project.hours} hours \u00b7 ${project.summary}`, href: `/concepts/${project.id}`, cta: 'See the project brief', build: true },
  ],
};

// "Recommendations with reasons": counted from the content at build time.
const checked = jobRoutes.filter((r) => r.evidence);
const sections = c.concepts.flatMap((x) => x.resources);
const stats = [
  { n: checked.reduce((n, r) => n + r.evidence!.postings, 0), label: 'Entry-level job listings the routes were checked against' },
  { n: checked.length, of: jobRoutes.length, label: 'Job routes checked against those listings. The rest say "draft".' },
  { n: counts.resources, label: 'Free books, courses and practice sites picked' },
  { n: sections.filter((x) => x.verified).length, label: 'Chapter and lecture references opened and checked' },
];
---

<Base title="Terminus" wide>
  <section class="intro" id="start" aria-labelledby="intro-heading">
    <div class="intro-text">
      <p class="sec-label" data-reveal><span class="sec-n">01</span>A study plan built around you</p>
      <h1 id="intro-heading" data-reveal style="--delay: 0.04s">Roadmaps are the same for everyone. This one <span class="mark">starts from you.</span></h1>
      <p class="lede" data-reveal style="--delay: 0.08s">
        Say where you're starting and which job you want. Terminus works out every topic in between, leaves out what
        you already know, and puts the rest in order, like stops on a line.
      </p>
      <form class="ticket" action="/roles" method="get" data-picker data-reveal style="--delay: 0.14s">
        <div class="ticket-main">
          <div class="ticket-row">
            <label class="ticket-label" id="ticket-from" for="ticket-from-select">From</label>
            <select name="from" id="ticket-from-select" required>
              <option value="" disabled selected>Your degree, or the job you do now</option>
              {BACKGROUND_GROUPS.map((g) => (
                <optgroup label={g.title}>
                  {c.backgrounds.filter((b) => b.group === g.id).map((b) => <option value={b.id}>{b.title}</option>)}
                </optgroup>
              ))}
              <optgroup label="Already working as">
                {jobs.map((r) => <option value={`role:${r.id}`}>{r.title}</option>)}
              </optgroup>
            </select>
          </div>
          <div class="ticket-row">
            <label class="ticket-label" id="ticket-to" for="ticket-to-select">To</label>
            <select name="role" id="ticket-to-select" required>
              <option value="" disabled selected>One of {jobs.length} jobs or {exams.length} exams</option>
              {groups.map(({ family, roles }) => (
                <optgroup label={family.title}>
                  {roles.map((r) => <option value={r.id}>{r.title}</option>)}
                </optgroup>
              ))}
            </select>
          </div>
        </div>
        <div class="ticket-stub">
          <button type="submit" class="btn">Plan my route <span aria-hidden="true">&rarr;</span></button>
          <span class="ticket-small">Free. No account.</span>
        </div>
      </form>
      <ul class="strip" data-reveal style="--delay: 0.2s">
        <li>{jobs.length} jobs</li>
        <li>{exams.length} exams</li>
        <li>A free pick at every stop</li>
        <li>No account</li>
      </ul>
      <p class="intro-more" data-reveal style="--delay: 0.24s">
        <a href="#lines">Or explore all {lineWord} lines</a> <span aria-hidden="true">&darr;</span>
        <span class="quiet"> &middot; Or learn just one tool: <a href="/tools">any of {toolCount}</a></span>
      </p>
      <div class="welcome" data-welcome hidden>
        <h2>Welcome back. The jobs closest to where you are:</h2>
        <ol data-welcome-list></ol>
      </div>
    </div>
    <div class="intro-ride" data-reveal style="--delay: 0.2s">
      <p class="ride-label" data-ride-label>Example route</p>
      <HeroRide />
    </div>
    <script type="application/json" id="preview-data" set:html={JSON.stringify(previewData)} />
  </section>

  <section class="sec" id="lines" aria-labelledby="lines-heading">
    <div class="sechead">
      <p class="sec-label" data-reveal><span class="sec-n">02</span>Choose a direction</p>
      <div>
        <h2 id="lines-heading" class="h2" data-reveal>Where could you go?</h2>
        <p class="lede2" data-reveal style="--delay: 0.06s">
          {lineWord.charAt(0).toUpperCase() + lineWord.slice(1)} lines, one for each family of jobs. Pick a line to see its jobs and the stops they share. Where two
          lines meet at a stop, those jobs ask for the same skills, so that's where you can change from one career to
          the other.
        </p>
      </div>
    </div>
    <LinesExplorer />
    <p class="lines-foot">
      Not sure which line fits? <button type="button" class="link-button" data-plan-start>Start with what you know</button> and the route works it out.
    </p>
    <p class="exams-line quiet">
      <a href="/roles">All {jobs.length} job titles</a>, grouped by route. Studying for an exam instead?{' '}
      {exams.map((r, i) => (
        <>{i > 0 && ', '}<a href={`/roles/${r.id}`}>{r.title}</a></>
      ))}
      .
    </p>
  </section>

  <section class="sec" id="stop" aria-labelledby="stop-heading">
    <div class="sechead">
      <p class="sec-label" data-reveal><span class="sec-n">03</span>More than a checklist</p>
      <div>
        <h2 id="stop-heading" class="h2" data-reveal>Every stop tells you exactly what to do.</h2>
        <p class="lede2" data-reveal style="--delay: 0.06s">
          Learn the idea, practise it, then use it in something you build. Every pick is free, and every chapter and
          lecture it points to has been opened and checked.
        </p>
      </div>
    </div>
    <div class="stop" data-reveal>
      <div class="stop-main">
        <p class="kicker">Stop {stop.n} of {stop.of} &middot; {stop.route}</p>
        <h3 class="stop-title">{stop.title}</h3>
        <p class="quiet">{stop.summary}</p>
        <div class="why">
          <p class="why-head">Why this stop?</p>
          <p>{stop.why}</p>
        </div>
        <ul class="stop-chips">
          <li>About {stop.hours} hours</li>
          {stop.after && <li>After {stop.after}</li>}
          <li>Every link checked</li>
        </ul>
        <a class="stop-open" href={`/concepts/${stop.id}`}>Open this stop <span aria-hidden="true">&rarr;</span></a>
      </div>
      <div class="tiles">
        {stop.tiles.map((t, i) => (
          <div class:list={['tile', { build: t.build }]} data-reveal style={`--delay: ${0.12 + i * 0.1}s`}>
            <span class="tile-k">{String(i + 1).padStart(2, '0')} &middot; {t.kind}</span>
            <p class="tile-t">{t.title}</p>
            <p class="tile-m">{t.meta}</p>
            <a class="tile-l" href={t.href} target={t.build ? undefined : '_blank'} rel={t.build ? undefined : 'noopener'}>
              {t.cta} <span aria-hidden="true">{t.build ? '\u2192' : '\u2197'}</span>
            </a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="band how" id="how" aria-labelledby="how-heading" data-explain data-step="1">
    <div class="sechead on-dark">
      <p class="sec-label" data-reveal><span class="sec-n">04</span>How it works</p>
      <div>
        <h2 id="how-heading" class="h2" data-reveal>From a job title to a route you can follow.</h2>
        <p class="lede2" data-reveal style="--delay: 0.06s">Every stop has a reason to be there. Here are the three steps, shown with one real route. Scroll through them, or pick one.</p>
      </div>
    </div>
    <div class="how-grid">
      <ol class="how-steps on-dark">
        <li data-step-text="1">
          <button type="button" class="step-head" data-go="1"><span class="step-n">1</span><span class="step-title">Start from the job</span></button>
          <div class="step-body">
            <svg class="step-ico" viewBox="0 0 54 40" aria-hidden="true"><circle cx="8" cy="20" r="5" class="i-ink" /><path d="M13 20h22" class="i-yel" /><rect x="38" y="8" width="8" height="24" class="i-fill" /></svg>
            <p>
              Every role lists what gets you hired, what the first year expects, and what's good to have, checked
              against real entry-level listings where we have them. For {midSentence(explain.role)}s the hiring list
              comes to {explain.total} stops, from the very first one.
            </p>
          </div>
        </li>
        <li data-step-text="2">
          <button type="button" class="step-head" data-go="2"><span class="step-n">2</span><span class="step-title">Strike off what you know</span></button>
          <div class="step-body">
            <svg class="step-ico" viewBox="0 0 54 40" aria-hidden="true"><circle cx="8" cy="12" r="5" class="i-dim" /><path d="M17 12h30" class="i-dim" /><path d="M3 12h48" class="i-yel" /><circle cx="8" cy="30" r="5" class="i-ink" /><path d="M17 30h30" class="i-ink" /></svg>
            <p>
              Every topic lists what you need to know before it. Terminus walks back from the job through those and
              stops wherever your degree or your current job already covers the ground. A maths or statistics degree
              covers {explain.skipped} of these stops, so they go.
            </p>
          </div>
        </li>
        <li data-step-text="3">
          <button type="button" class="step-head" data-go="3"><span class="step-n">3</span><span class="step-title">Follow one clear route</span></button>
          <div class="step-body">
            <svg class="step-ico" viewBox="0 0 54 40" aria-hidden="true"><path d="M8 4v32" class="i-yel" /><circle cx="8" cy="8" r="4" class="i-ink i-solid" /><circle cx="8" cy="20" r="4" class="i-ink i-solid" /><circle cx="8" cy="32" r="4" class="i-ink i-solid" /><path d="M20 8h26M20 20h20M20 32h24" class="i-dim" /></svg>
            <p>
              What's left goes in prerequisite order, longest chains first, staying on one line at a time where it can.
              Each stop comes with free picks to read, watch or practise, and a time estimate: {explain.left} stops,
              {' '}{explain.time} at 10 hours a week.
            </p>
          </div>
        </li>
      </ol>
      <div class="explain-card" aria-hidden="true">
        <p class="explain-head">{explain.title}</p>
        <div class="explain-line" style={`--rows:${explain.total}; --left:${explain.left}`}>
          <span class="explain-rail"></span>
          {explain.rows.map((r) => (
            <div class="explain-row" data-skip={r.o < 0 ? 'true' : undefined} style={`--a:${r.a}; --o:${r.o}`}>
              <span class="explain-dot"></span>
              <span class="explain-title">{r.title}</span>
              <span class="explain-tag"><span class="tag-h">{r.hours} h</span>{r.o < 0 && <span class="tag-cover">Your degree covers it</span>}</span>
            </div>
          ))}
          <div class="explain-end"><span class="run-bar"></span><span class="explain-board">{explain.role}</span></div>
        </div>
        <p class="explain-note">
          <span data-note="1">{explain.total} stops on the hiring list, in no particular order.</span>
          <span data-note="2">{explain.skipped} are already behind you. {explain.left} are left.</span>
          <span data-note="3">{explain.left} stops, {explain.time} at 10 hours a week.</span>
        </p>
      </div>
    </div>
  </section>

  <section class="sec" id="trust" aria-labelledby="trust-heading">
    <div class="sechead">
      <p class="sec-label" data-reveal><span class="sec-n">05</span>Built to be trusted</p>
      <div>
        <h2 id="trust-heading" class="h2" data-reveal>Recommendations with reasons.</h2>
        <p class="lede2" data-reveal style="--delay: 0.06s">
          Routes come from real job listings, the prerequisites between topics, and free resources opened and checked
          by hand. Here is how much of that is done so far.
        </p>
        <dl class="stats" data-stats data-reveal>
          {stats.map((x) => (
            <div class="stat">
              <dt>{x.label}</dt>
              <dd><span class="num" data-count={x.n}>{x.n.toLocaleString('en-IN')}</span>{x.of && <small> of {x.of}</small>}</dd>
            </div>
          ))}
        </dl>
        <p class="stats-foot">
          <span class="faint">Counted from Terminus's own content files every time the site is built. Concepts: {counts.concepts}, tools: {counts.tools}, projects: {counts.projects}.</span>
          <a href="/method">How routes are checked <span aria-hidden="true">&rarr;</span></a>
        </p>
      </div>
    </div>
  </section>

  <section class="band cta" aria-labelledby="cta-heading">
    <div class="cta-inner">
      <div>
        <p class="sec-label" data-reveal><span class="sec-n">06</span>Learn without the guesswork</p>
        <h2 id="cta-heading" class="h2" data-reveal>One route. Everything you need.</h2>
        <p class="cta-lede" data-reveal>Free books, video courses and hands-on practice, picked for every stop and put in the order you need them.</p>
      </div>
      <button type="button" class="cta-btn" data-plan-start data-reveal>Plan my route <span aria-hidden="true">&rarr;</span></button>
    </div>
  </section>
</Base>

<script>
  import { planPath, withPrerequisites, type ConceptNode } from '../lib/graph';
  import { duration } from '../lib/coaches';
  import { closestJobs, type JobTarget } from '../lib/closest';
  import { indexConcepts } from '../lib/graph';
  import { enhanceSelect } from '../scripts/picker';

  interface PreviewData {
    nodes: ConceptNode[];
    areas: Record<string, string>;
    backgrounds: Record<string, { phrase?: string; job?: string; knows: string[] }>;
    roles: Record<string, { title: string; hire: string[] }>;
  }

  const form = document.querySelector<HTMLFormElement>('[data-picker]')!;
  const fromSelect = form.querySelector<HTMLSelectElement>('select[name="from"]')!;
  const roleSelect = form.querySelector<HTMLSelectElement>('select[name="role"]')!;
  const fromPicker = enhanceSelect(fromSelect, { search: 'Type your degree or job', labelId: 'ticket-from' });
  const rolePicker = enhanceSelect(roleSelect, { search: 'Type a job, like data or backend', labelId: 'ticket-to' });

  // Send the ticket straight to the role page; without JavaScript it falls back to the roles list.
  form.addEventListener('submit', (e) => {
    e.preventDefault();
    if (!roleSelect.value) return rolePicker.open();
    const from = fromSelect.value;
    location.href = `/roles/${roleSelect.value}${from ? `?from=${from}` : ''}`;
  });
  // Picking a job with no starting point yet: ask where they're starting from next.
  roleSelect.addEventListener('change', () => { if (!fromSelect.value) setTimeout(() => fromPicker.button.classList.add('nudge'), 300); });
  fromSelect.addEventListener('change', () => fromPicker.button.classList.remove('nudge'));

  const data: PreviewData = JSON.parse(document.getElementById('preview-data')!.textContent!);
  const rideLabel = document.querySelector<HTMLElement>('[data-ride-label]')!;
  const motion = () => document.documentElement.classList.contains('motion');

  // "Start with what you know" and the closing button: back up to the ticket, From open.
  document.querySelectorAll<HTMLButtonElement>('[data-plan-start]').forEach((b) => b.addEventListener('click', () => {
    document.getElementById('start')!.scrollIntoView({ behavior: motion() ? 'smooth' : 'auto', block: 'start' });
    setTimeout(() => fromPicker.open(), motion() ? 550 : 0);
  }));

  // The trust numbers count up the first time they come into view.
  const stats = document.querySelector<HTMLElement>('[data-stats]');
  if (stats && motion() && 'IntersectionObserver' in window) {
    const nums = [...stats.querySelectorAll<HTMLElement>('[data-count]')];
    const io = new IntersectionObserver(([e]) => {
      if (!e!.isIntersecting) return;
      io.disconnect();
      const t0 = performance.now();
      const tick = (t: number) => {
        const k = Math.min(1, (t - t0) / 1300);
        const ease = 1 - Math.pow(1 - k, 3);
        for (const n of nums) n.textContent = Math.round(Number(n.dataset.count) * ease).toLocaleString('en-IN');
        if (k < 1) requestAnimationFrame(tick);
      };
      requestAnimationFrame(tick);
    }, { threshold: 0.4 });
    io.observe(stats);
  }
  const titles = new Map(data.nodes.map((n) => [n.id, n.title]));

  // Re-plan whenever the ticket changes: the ride plays the visitor's own route, and the map greys out what's behind them.
  function update() {
    const fd = new FormData(form);
    const from = String(fd.get('from') ?? '');
    const bg = data.backgrounds[from];
    const roleId = String(fd.get('role') ?? '');
    const role = data.roles[roleId];
    document.dispatchEvent(
      new CustomEvent('terminus:ticket', {
        detail: {
          known: [...withPrerequisites(data.nodes, bg?.knows ?? [])],
          from: from.startsWith('role:') ? from.slice(5) : undefined,
          fromId: from || undefined,
          fromLabel: bg ? bg.job ?? fromSelect.selectedOptions[0]?.textContent ?? '' : '',
          to: roleId || undefined,
        },
      }),
    );
    if (!role) return; // the ride waits for a job
    rideLabel.textContent = 'Your route';
    const known = new Set(bg?.knows ?? []);
    const full = planPath(data.nodes, role.hire, new Set());
    const mine = planPath(data.nodes, role.hire, known);
    const left = new Set(mine.steps.map((s) => s.id));
    const skipped = full.steps.filter((s) => !left.has(s.id)).slice(0, 3).map((s) => s.id);
    const ahead = mine.steps.slice(0, bg ? 4 : 6).map((s) => s.id);
    const show = full.steps.filter((s) => skipped.includes(s.id) || ahead.includes(s.id));
    document.dispatchEvent(
      new CustomEvent('terminus:ride', {
        detail: {
          from: bg?.job ?? (bg ? fromSelect.selectedOptions[0]?.textContent ?? '' : 'The very beginning'),
          covers: bg?.job ? 'Your job covers it' : 'Your degree covers it',
          to: role.title,
          stops: show.map((s) => ({ title: titles.get(s.id) ?? s.title, hours: s.hours, skip: !left.has(s.id) })),
          more: mine.steps.length - ahead.length,
          behind: full.steps.length - mine.steps.length,
          time: duration(mine.totalHours, 10),
        },
      }),
    );
  }

  // Someone coming back: their saved progress, and the jobs it puts them nearest to.
  (async () => {
    let me: { background?: string; known?: string[]; done?: string[]; pace?: number } = {};
    try {
      me = JSON.parse(localStorage.getItem('terminus:me') ?? localStorage.getItem('pregraph:me') ?? '{}') ?? {};
    } catch {
      return;
    }
    const have = new Set([...(me.known ?? []), ...(me.done ?? []), ...(me.background ? data.backgrounds[me.background]?.knows ?? [] : [])]);
    if (have.size === 0) return;
    const routes: JobTarget[] = await fetch('/routes.json').then((r) => r.json()).catch(() => []);
    const near = closestJobs(indexConcepts(data.nodes), routes, have, 3);
    if (near.length === 0) return;
    const box = document.querySelector<HTMLElement>('[data-welcome]')!;
    const ol = box.querySelector('[data-welcome-list]')!;
    for (const j of near) {
      const li = document.createElement('li');
      const a = document.createElement('a');
      a.href = `/roles/${j.id}`;
      a.textContent = j.title;
      const span = document.createElement('span');
      span.className = 'quiet';
      span.textContent = j.stops === 0 ? ': its hiring list is all behind you.' : `: ${j.stops} ${j.stops === 1 ? 'stop' : 'stops'} left, ${duration(j.hours, me.pace ?? 10)}.`;
      li.append(a, span);
      ol.append(li);
    }
    box.hidden = false;
  })();

  form.addEventListener('change', update);
  update(); // the browser may have kept the last choices on a back navigation

  // "How the route is worked out": the card follows whichever step is in the middle of the screen.
  const explain = document.querySelector<HTMLElement>('[data-explain]');
  if (explain) {
    const setStep = (n: string) => { explain.dataset.step = n; };
    explain.querySelectorAll<HTMLButtonElement>('[data-go]').forEach((b) => b.addEventListener('click', () => setStep(b.dataset.go!)));
    const steps = [...explain.querySelectorAll<HTMLElement>('[data-step-text]')];
    const io = new IntersectionObserver(
      (entries) => {
        for (const en of entries) if (en.isIntersecting) setStep((en.target as HTMLElement).dataset.stepText!);
      },
      // On a phone the card sits over the top of the screen, so read the step lower down.
      { rootMargin: matchMedia('(max-width: 960px)').matches ? '-68% 0px -14% 0px' : '-45% 0px -45% 0px' },
    );
    steps.forEach((el) => io.observe(el));
  }
</script>

